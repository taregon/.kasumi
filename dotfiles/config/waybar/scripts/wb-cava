#!/usr/bin/env bash
# ╒══════════════════════════════════════════════════════════╕
# │                    VISUALIZADOR CAVA                     │
# ╘══════════════════════════════════════════════════════════╛
# Cava audio visualizer para Waybar
#
# NOTA (2026-10-07): este script fue auditado por consumo de CPU y declarado
# inocente. Mediciones con `top -b -n 6 -d 5` bajo las mismas condiciones
# (audio en reproducción): waybar 9.4% con framerate 15, 8.8% con framerate 45
# y 9.5% con la variante parcial; cava externo 1-3% en todos los casos.
# El recorte de framerate no mueve la aguja de waybar. En silencio waybar baja
# a ~5.4% aunque el stream sigue a 45 líneas/s, por lo que el costo correlacionado
# al audio proviene de los módulos reactivos (mpris, privacy, wireplumber),
# no de este visualizador. No reintroducir throttling como supuesta corrección.

set -euo pipefail

# ──「 CONFIGURACIÓN 」───────────────────────────────────────
config_file="$HOME/.config/cava/cava-waybar.conf"

# Evita múltiples instancias de cava compitiendo por el dispositivo de audio
pkill -f "cava -p $config_file" 2> /dev/null || true
sleep 0.1

# Cava emite dígitos 0-7; sed los envuelve en spans Pango con el tono
# verde del nivel (waybar interpreta markup con escape desactivado):
# 0→▁ 1→▂ 2→▃ 3→▄ 4→▅ 5→▆ 6→▇ 7→█
# Idea problable "⢀⢠⢰⢸"
# Paleta del usuario (2026-10-07, 2.ª escala): el nivel 7 usa el tono
# más claro y desciende hacia el nivel 0. De los 9 tonos recibidos se
# usan los 8 primeros; se descarta #2f3837 (casi indistinguible del
# fondo en el nivel mínimo).
bar_glyphs="▁▂▃▄▅▆▇█"
bar_colors=(3a4641 45554b 516554 5d755e 698568 759672 82a67d 8fb887)
# Sin espaciado con s/./& /g: esa regla insertaría espacios dentro
# de las etiquetas y rompería el markup. La separación se repone con
# un espacio tras cada </span>, fuera de las etiquetas.
# Doble etapa: los hex del span contienen dígitos, por lo que sustituir
# 0-7 en secuencia corrompería los spans ya insertados. Se transliteran
# primero a mayúsculas A-H (ausentes en hex y etiquetas) y luego cada
# letra se expande a su span.
sed_script="s/;//g;y/01234567/ABCDEFGH/"
bar_placeholders="ABCDEFGH"
bar_length=${#bar_glyphs}
for ((i = 0; i < bar_length; i++)); do
    sed_script+=";s/${bar_placeholders:$i:1}/<span color='#${bar_colors[$i]}'>${bar_glyphs:$i:1}<\/span> /g"
done

cat > "$config_file" << 'EOF'
[general]
bars = 12
framerate = 45
sensitivity = 250
lower_cutoff_freq = 70
higher_cutoff_freq = 9000

[smoothing]
monstercat = 0
gravity = 200
noise_reduction = 0.3

[input]
method = pipewire

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
EOF

# ──「 TUBERÍA 」─────────────────────────────────────────────
cava -p "$config_file" | sed -u "$sed_script"
