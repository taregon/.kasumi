#!/usr/bin/env bash
# Script de previsualización para lf (file manager).
# Genera previews de imágenes, video, PDF, audio, texto y archivos comprimidos.

set -euo pipefail

# ── Setup ─────────────────────────────────────────────────────────────

readonly FILE_PATH="$1"
readonly PREVIEW_WIDTH="$2"
readonly PREVIEW_HEIGHT="$3"
readonly PREVIEW_X="$4"
readonly PREVIEW_Y="$5"
readonly THUMB_SIZE=800
readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/lf"
readonly ICC_PROFILE="$HOME/.config/lf/icc/sRGB-v2-magic.icc"

# Dependencias requeridas (documentación y verificación opcional)
# xxhsum (xxhash), magick (imagemagick), chafa, kitty, pdftoppm (poppler),
# ffmpegthumbnailer, als (atool), aria2c, 7z (p7zip), ffprobe (ffmpeg),
# bat, jq, pandoc (pandoc-bin AUR, sin deps Haskell)

mkdir -p "$CACHE_DIR"

# ── Helpers de bajo nivel ─────────────────────────────────────────────

lfpreview_check_deps() {
    local missing=()
    local -a deps=(
        xxhsum magick chafa kitty pdftoppm ffmpegthumbnailer
        als aria2c 7z ffprobe bat jq pandoc
    )
    for dep in "${deps[@]}"; do
        command -v "$dep" > /dev/null || missing+=("$dep")
    done
    if ((${#missing[@]} > 0)); then
        # Causa: lf solo renderiza stdout en el panel; stderr queda oculto y el fallo parece panel vacío.
        local msg="lfpreview: dependencias faltantes: ${missing[*]}"
        printf '%s\n' "$msg" >&2
        printf '%s\n' "$msg"
        return 1
    fi
    return 0
}

lfpreview_create_cache_path() {
    local realfile
    realfile="$(readlink -f "$FILE_PATH" 2> /dev/null || realpath "$FILE_PATH")"
    local cache_key
    cache_key="$(stat --printf '%i\0%s\0%Y' "$realfile" | xxhsum -q | cut -d' ' -f1)"
    printf '%s/thumb-%s' "$CACHE_DIR" "$cache_key"
}

# NOTE: ImageMagick procesa opciones en orden secuencial. El orden afecta el resultado:
# 1. Settings (-define, -quality, -filter, -intent) persisten hasta que se resetean
# 2. Operators (-auto-orient, -strip, -colorspace, -thumbnail, -profile) se aplican
#    inmediatamente a la imagen actual
# 3. Para conversión de color correcta: colorspace → resize → colorspace → profile
# 4. -intent debe ir ANTES de -thumbnail para afectar la conversión durante resize
# 5. -strip antes de -colorspace elimina perfiles, pero -colorspace RGB no los necesita
# Ref: https://imagemagick.org/command-line-processing/

lfpreview_create_thumb() {
    local cache_path="$1"
    magick \
        -define jpeg:size="${THUMB_SIZE}x${THUMB_SIZE}" \
        -define jpeg:optimize-coding=true \
        -quality 90 \
        "$FILE_PATH" \
        -auto-orient \
        -strip \
        -sampling-factor 4:2:0 \
        -colorspace RGB \
        -intent Relative \
        -filter Triangle \
        -thumbnail "${THUMB_SIZE}x${THUMB_SIZE}>" \
        -colorspace sRGB \
        -profile "${ICC_PROFILE}" \
        "${cache_path}.jpg" 2> /dev/null
}

lfpreview_draw_ascii() {
    chafa \
        -s "${PREVIEW_WIDTH}x${PREVIEW_HEIGHT}" \
        --animate off \
        --colors 240 \
        --work 4 \
        --fg-only \
        --format symbols \
        --polite off \
        --symbols ascii \
        "$FILE_PATH"
}

lfpreview_draw_kitty() {
    local img="${1:-$FILE_PATH}"
    kitty +kitten icat --silent --stdin no --transfer-mode memory \
        --place "${PREVIEW_WIDTH}x${PREVIEW_HEIGHT}@${PREVIEW_X}x${PREVIEW_Y}" "$img" < /dev/null > /dev/tty
}

# ── Lógica intermedia ─────────────────────────────────────────────────

lfpreview_epub() {
    pandoc -s -t markdown "$FILE_PATH" \
        | bat -l markdown --color=always --paging=never --terminal-width="$PREVIEW_WIDTH"
}

lfpreview_json() {
    jq -C "." "$FILE_PATH" 2> /dev/null \
        || bat --color=always --paging=never --style=plain --terminal-width="$PREVIEW_WIDTH" "$FILE_PATH"
}

lfpreview_pdf() {
    local cache_path
    cache_path="$(lfpreview_create_cache_path)"
    [[ -s "${cache_path}.jpg" ]] || pdftoppm -jpeg -f 1 \
        -scale-to "$THUMB_SIZE" \
        -jpegopt quality=70,progressive=y,optimize=y \
        -singlefile "$FILE_PATH" "$cache_path"
    lfpreview_draw_kitty "${cache_path}.jpg" || lfpreview_draw_ascii
}

lfpreview_torrent() {
    aria2c -S "$FILE_PATH"
}

lfpreview_archive() {
    als "$FILE_PATH"
}

lfpreview_audio() {
    ffprobe -show_format -show_streams -of default=noprint_wrappers=1:nokey=1 "$FILE_PATH" 2> /dev/null
}

lfpreview_gif() {
    lfpreview_draw_ascii
}

lfpreview_image() {
    local cache_path
    cache_path="$(lfpreview_create_cache_path)"
    [[ -s "${cache_path}.jpg" ]] || lfpreview_create_thumb "$cache_path"
    lfpreview_draw_kitty "${cache_path}.jpg" || lfpreview_draw_ascii
}

lfpreview_text() {
    bat --color=always --paging=never --style=plain --terminal-width="$PREVIEW_WIDTH" "$FILE_PATH"
}

lfpreview_video() {
    local cache_path
    cache_path="$(lfpreview_create_cache_path)"
    [[ -s "${cache_path}.jpg" ]] || ffmpegthumbnailer -i "$FILE_PATH" -o "${cache_path}.jpg" -s 0 -c jpeg
    lfpreview_draw_kitty "${cache_path}.jpg"
}

# ── Orquestación ──────────────────────────────────────────────────────

lfpreview_main() {
    lfpreview_check_deps || exit 1

    local mimetype
    mimetype="$(file -L --brief --mime-type "$FILE_PATH")"

    case "$mimetype" in
        */epub+zip | */x-fictionbook+xml)
            lfpreview_epub
            ;;
        application/json)
            lfpreview_json
            ;;
        application/pdf)
            lfpreview_pdf
            ;;
        application/x-bittorrent)
            lfpreview_torrent
            ;;
        application/zip | application/gzip | application/java-archive | \
            application/vnd.rar | application/x-7z-compressed | \
            application/x-bzip2 | application/x-cab | application/x-cpio | \
            application/x-deb | application/x-lzma | application/x-rar | \
            application/x-tar | application/x-xz | application/x-zstd | \
            application/zstd | application/vnd.ms-cab-compressed)
            lfpreview_archive
            ;;
        audio/*)
            lfpreview_audio
            ;;
        image/gif)
            lfpreview_gif
            ;;
        image/*)
            lfpreview_image
            ;;
        text/* | */xml)
            lfpreview_text
            ;;
        video/*)
            lfpreview_video
            ;;
    esac

    case "$FILE_PATH" in
        *.img)
            7z l "$FILE_PATH"
            ;;
    esac
}

# ── Punto de entrada ──────────────────────────────────────────────────

lfpreview_main "$@"

# WARN: exit 1 es INTENCIONAL. lf usa el código de salida del previewer para
# decidir si limpia el área de preview. Exit 0 → lf limpia y espera stdout.
# Exit !=0 → lf preserva el área, permitiendo que kitty icat escriba a /dev/tty.
# Cambiar a exit $? o exit 0 DESTRUYE la vista previa en la segunda pasada.
exit 1
