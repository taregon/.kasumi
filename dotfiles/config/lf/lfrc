# ╒══════════════════════════════════════════════════════════╕
# │                   CONFIGURACIÓN DE LF                    │
# ╘══════════════════════════════════════════════════════════╛
# https://man.archlinux.org/man/lf.1.en

# ──「 SHELL 」───────────────────────────────────────────────
# En zsh, ${(f)fx} divide las selecciones por líneas y conserva espacios.
# Al crear archivos, se usan solo los nombres base para evitar rutas absolutas.
# lfpreview y lfclean usan bash; los comandos interactivos, zsh.
  set shell zsh
  set shellopts '-eu'
  set ifs "\n"

# ──「 INTERFAZ Y BÚSQUEDA 」─────────────────────────────────
  set dircounts true
  set drawbox true
  set icons true
  set ignorecase true
  set incsearch true
  set smartdia true
  set scrolloff 10

# ──「 VISTA PREVIA 」────────────────────────────────────────
  set preview true
  set period 3
  set previewer ~/.config/lf/lfpreview
  set cleaner ~/.config/lf/lfclean
  set ratios 1:2:2

# ──「 INFORMACIÓN Y ORDEN 」─────────────────────────────────
  set info ctime:size
  set infotimefmtnew "Jan _2 2006"
  set infotimefmtold "Jan _2 2006"
  set sortby ctime

# ╒══════════════════════════════════════════════════════════╕
# │                          ATAJOS                          │
# ╘══════════════════════════════════════════════════════════╛

# ──「 NAVEGACIÓN Y SELECCIÓN 」──────────────────────────────
  map <delete> delete
  map <enter> open
  map ? $rofi -dmenu -i -no-custom -p 'Atajos' -theme ~/.config/rofi/themes/keybind-helper.rasi < ~/.config/lf/shortcuts.txt
  map gN cd ~/Syncthing/OsiriaFS/Notas

# ──「 ARCHIVOS Y DIRECTORIOS 」──────────────────────────────
  map . set hidden!
  map X $lf-basenames-null <<< "$fx" | xargs -0 trash-put
  map a push $mkdir<space>

# ──「 COPIAR Y ARRASTRAR 」──────────────────────────────────
  map y
  map yy copy
  map yp %printf '%s\n' ${(f)fx} | wl-copy
  map o $lf-basenames <<< "$fs" | ripdrag -W 400 -H 200 -s 195 -b -I

# ──「 COMANDOS PERSONALIZADOS 」─────────────────────────────
  map <c-f> :fzf_find
  map <c-g> :search_content
  map gll follow_link
  map glp paste_link
  map gxx trash_old
  map ge age_encrypt
  map gd age_decrypt
  map E extract
  map A create_archive

# ──「 DEFINICIONES DE COMANDOS 」────────────────────────────
  source ~/.config/lf/cmds/on-select.lf
  source ~/.config/lf/cmds/fzf_find.lf
  source ~/.config/lf/cmds/search_content.lf
  source ~/.config/lf/cmds/follow_link.lf
  source ~/.config/lf/cmds/extract.lf
  source ~/.config/lf/cmds/create_archive.lf
  source ~/.config/lf/cmds/paste_link.lf
  source ~/.config/lf/cmds/trash_old.lf
  source ~/.config/lf/cmds/age.lf
