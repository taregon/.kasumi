# vim: filetype=config
# Cifrar con los archivos públicos de $XDG_CONFIG_HOME/age y descifrar con la
# identidad del custodio sahaquiel, en /var/lib/sahaquiel/age/sahaquiel.key.
# ge lee solo públicos; gd pide la contraseña de sahaquiel por tty.

cmd age_encrypt %{{
  agedir="${XDG_CONFIG_HOME:-$HOME/.config}/age"
  pubkey="$agedir/sahaquiel.pub"
  recipients="$agedir/recipients.txt"
  if [ ! -r "$pubkey" ]; then
    lf -remote "send $id echoerr No se encuentra el público de age: $pubkey"
    exit 1
  fi

  if [ -s "$recipients" ]; then
    # Sin el destinatario propio nadie aquí podría descifrar.
    if ! grep -qFx -f "$pubkey" "$recipients"; then
      lf -remote "send $id echoerr Falta el destinatario propio en $recipients"
      exit 1
    fi
    target=(-R "$recipients")
  else
    target=(-r "$(<"$pubkey")")
  fi

  encrypted=0 omitted=0 failed=0
  for file in ${(f)fx}; do
    out="$file.age"
    if [ ! -f "$file" ]; then
      failed=$((failed + 1))
    # age sobrescribe la salida sin avisar; se comprueba antes.
    elif [ -e "$out" ]; then
      omitted=$((omitted + 1))
    elif age -e "${target[@]}" -o "$out" "$file"; then
      encrypted=$((encrypted + 1))
    else
      failed=$((failed + 1))
    fi
  done

  msg="Cifrado: $encrypted, omitidos: $omitted, fallidos: $failed"
  if [ "$failed" -gt 0 ]; then
    lf -remote "send $id echoerr $msg"
  else
    lf -remote "send $id echo Cifrado: $encrypted, omitidos: $omitted"
  fi
}}

cmd age_decrypt ${{
  # $ pausa la interfaz: su necesita una tty para pedir la contraseña.
  # El primer argumento tras -c ocupa $0 en el shell de sahaquiel.
  decrypted=0 omitted=0 failed=0
  for file in ${(f)fx}; do
    case "$file" in
      *.age) out="${file%.age}" ;;
      *) failed=$((failed + 1)); continue ;;
    esac
    if [ ! -f "$file" ]; then
      failed=$((failed + 1))
    elif [ -e "$out" ]; then
      omitted=$((omitted + 1))
    else
      # El custodio no puede acceder a los archivos de quien invoca. El
      # descriptor 3 abre la entrada como el invocante; stdin queda libre
      # para que su pida la contraseña y age lee desde <&3.
      tmp="${out}.tmp.$$"
      if su -s /bin/sh sahaquiel -c \
        '/usr/sbin/age -d -i /var/lib/sahaquiel/age/sahaquiel.key <&3' \
        sahaquiel-age 3< "$file" > "$tmp" && mv -- "$tmp" "$out"; then
        decrypted=$((decrypted + 1))
      else
        rm -f -- "$tmp"
        failed=$((failed + 1))
      fi
    fi
  done

  msg="Descifrado: $decrypted, omitidos: $omitted, fallidos: $failed"
  if [ "$failed" -gt 0 ]; then
    lf -remote "send $id echoerr $msg"
  else
    lf -remote "send $id echo Descifrado: $decrypted, omitidos: $omitted"
  fi
}}
