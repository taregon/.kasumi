# vim: filetype=config
# Cifrar con los públicos de confianza en /etc/age y descifrar con la
# identidad del custodio sahaquiel, en /var/lib/sahaquiel/age/sahaquiel.key.
# ge no lee la privada; gd pide la contraseña de sahaquiel por tty.
#
# Modelo de amenazas: un agente con el usuario que invoca puede leer su
# configuración, pero no la privada ni /etc/age, que pertenecen a sahaquiel
# y a root respectivamente. Por eso se ignoran las copias de los públicos
# que haya en el directorio age del invocante.
#
# Los temporales se crean con mktemp junto al destino: nombre imprevisible,
# permisos 600 y publicación con rename atómico. La carrera sobre el destino
# no cruza un límite de privilegio: quien podría crearlo es el invocante.

cmd age_encrypt %{{
  # root:root, directorio 755 y archivos 644: solo lectura para el invocante.
  trusted=/etc/age
  recipients="$trusted/recipients.txt"
  pubkey="$trusted/sahaquiel.pub"
  if [ ! -r "$recipients" ] || [ ! -r "$pubkey" ]; then
    lf -remote "send $id echoerr Faltan los públicos de confianza en $trusted"
    exit 1
  fi
  # Coincidencia exacta de línea: un pub distinto no debe pasar el filtro.
  if ! grep -qFx -f "$pubkey" "$recipients"; then
    lf -remote "send $id echoerr Falta el destinatario propio en $recipients"
    exit 1
  fi

  encrypted=0 omitted=0 failed=0
  for file in ${(f)fx}; do
    tmp=''
    out="$file.age"
    if [ ! -f "$file" ]; then
      failed=$((failed + 1))
    elif [ -e "$out" ]; then
      omitted=$((omitted + 1))
    # Mismo directorio que el destino: mktemp fija 600 y mv es atómico.
    elif tmp=$(mktemp "${out}.tmp.XXXXXX" 2>/dev/null) &&
      age -e -R "$recipients" -o "$tmp" "$file" &&
      mv -- "$tmp" "$out"; then
      encrypted=$((encrypted + 1))
    else
      if [ -n "$tmp" ]; then
        rm -f -- "$tmp"
      fi
      failed=$((failed + 1))
    fi
  done

  msg="Cifrado: $encrypted, omitidos: $omitted, fallidos: $failed"
  if [ "$failed" -gt 0 ]; then
    lf -remote "send $id echoerr $msg"
  else
    lf -remote "send $id echo Cifrado: $encrypted, omitidos: $omitted"
  fi
}}

cmd age_decrypt ${{
  # $ pausa la interfaz: su necesita una tty para pedir la contraseña.
  # Refuerzo para el archivo que se abre por redirección; mktemp ya fija 600.
  umask 077
  decrypted=0 omitted=0 failed=0
  for file in ${(f)fx}; do
    tmp=''
    case "$file" in
      *.age) out="${file%.age}" ;;
      *) failed=$((failed + 1)); continue ;;
    esac
    if [ ! -f "$file" ]; then
      failed=$((failed + 1))
    elif [ -e "$out" ]; then
      omitted=$((omitted + 1))
    elif tmp=$(mktemp "${out}.tmp.XXXXXX" 2>/dev/null); then
      # El custodio no puede acceder a los archivos de quien invoca. El
      # descriptor 3 los abre como invocante y deja stdin para la contraseña;
      # age lee desde ese descriptor y escribe en el temporal, no en el destino.
      if su -s /bin/sh sahaquiel -c \
        '/usr/sbin/age -d -i /var/lib/sahaquiel/age/sahaquiel.key <&3' \
        sahaquiel-age 3< "$file" > "$tmp" && mv -- "$tmp" "$out"; then
        decrypted=$((decrypted + 1))
      else
        rm -f -- "$tmp"
        failed=$((failed + 1))
      fi
    else
      failed=$((failed + 1))
    fi
  done

  msg="Descifrado: $decrypted, omitidos: $omitted, fallidos: $failed"
  if [ "$failed" -gt 0 ]; then
    lf -remote "send $id echoerr $msg"
  else
    lf -remote "send $id echo Descifrado: $decrypted, omitidos: $omitted"
  fi
}}
