# vim: filetype=config
# Empaquetar la selección como tarball zstd, porque atool no conoce zstd.
# Compresión con tar --zstd; el resto de formatos los cubre pack_any.

cmd pack_zstd ${{
  clear
  tput sgr0
  tput cup $(($(tput lines)/3))
  tput bold
  set -f

  printf '%s\n' $fx
  printf "\t¿Empaquetar en zstd? [s/N] "
  read -r reply
  clear
  case "$reply" in
    [yYsS])
      printf 'Nombre del archivo: '
      read -r name
      clear
      [ -z "$name" ] && exit 0
      # Solo una extensión zstd se respeta; cualquier otra se corrige al
      # formato real para no dejar un archivo que mienta sobre su compresión.
      case "$name" in
        *.zst|*.tzst) ;;
        *) name="$name.tar.zst" ;;
      esac
      # stdin desde /dev/null evita un prompt de sobrescritura invisible.
      if output="$(tar --zstd -cf "$name" ${${(f)fx}##*/} </dev/null 2>&1)"; then
        lf -remote "send $id echo Empaquetado completado"
      else
        message="$(printf '%s\n' "$output" |
          sed '/^[[:space:]]*$/d' |
          head -n 2 | tr -d '"' | paste -sd ' ' -)"
        lf -remote "send $id echoerr Falló el empaquetado: $message"
      fi
      ;;
  esac
}}
