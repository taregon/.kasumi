# vim: filetype=config
# Empaquetar la selección como tarball zstd, porque atool no conoce zstd.
# Nivel 6 con todos los núcleos: mismo consumo que el nivel 3 (~85 MiB) y
# ~8 % menos de tamaño. --rsyncable permite que un backup con el mismo
# nombre se sincronice por bloques. El resto de formatos los cubre pack_any.

cmd pack_zstd ${{
  clear
  tput sgr0
  tput cup $(($(tput lines)/3))
  tput bold
  set -f

  printf '%s\n' $fx
  printf "\t¿Empaquetar en zstd? [s/N] "
  read -r reply
  clear
  case "$reply" in
    [yYsS])
      printf 'Nombre del archivo: '
      read -r name
      clear
      [ -z "$name" ] && exit 0
      # Solo una extensión zstd se respeta; cualquier otra se corrige al
      # formato real para no dejar un archivo que mienta sobre su compresión.
      case "$name" in
        *.zst|*.tzst) ;;
        *) name="$name.tar.zst" ;;
      esac
      # GNU tar no acepta el nivel dentro de --zstd; el programa se pasa
      # completo. stdin desde /dev/null evita un prompt de sobrescritura
      # invisible.
      if output="$(tar --use-compress-program='zstd -T0 -6 --rsyncable' \
        -cf "$name" ${${(f)fx}##*/} </dev/null 2>&1)"; then
        lf -remote "send $id echo Empaquetado completado"
      else
        message="$(printf '%s\n' "$output" |
          sed '/^[[:space:]]*$/d' |
          head -n 2 | tr -d '"' | paste -sd ' ' -)"
        lf -remote "send $id echoerr Falló el empaquetado: $message"
      fi
      ;;
  esac
}}
