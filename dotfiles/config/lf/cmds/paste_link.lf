# vim: filetype=config
# Crear enlaces simbólicos en el directorio actual desde el portapapeles de lf.
# El modo move no se aplica: solo se enlaza y el origen permanece.
cmd paste_link %{{
  # Misma precedencia que lf: LF_DATA_HOME > XDG_DATA_HOME > ~/.local/share.
  # Sin expansión anidada: un cierre doble de llaves cerraría el comando.
  data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  data_home="${LF_DATA_HOME:-$data_home}"
  filesfile="$data_home/lf/files"

  if [ ! -r "$filesfile" ]; then
    printf 'No se encuentra el portapapeles de lf: %s\n' "$filesfile"
    exit 1
  fi

  # El descriptor evita el proceso de tail y deja stdin libre.
  exec 3< "$filesfile"
  IFS= read -r mode <&3 || mode=""
  case "$mode" in
    copy|move) ;;
    *) printf 'Formato de portapapeles de lf desconocido: %s\n' "$mode"; exit 1 ;;
  esac

  linked=0 omitted=0 failed=0
  while IFS= read -r source <&3 || [ -n "$source" ]; do
    [ -n "$source" ] || continue
    name="${source##*/}"
    if [ ! -e "$source" ] && [ ! -L "$source" ]; then
      omitted=$((omitted + 1))
      printf 'No existe el origen; se omite: %s\n' "$source"
    elif [ -e "./$name" ] || [ -L "./$name" ]; then
      omitted=$((omitted + 1))
      printf 'Ya existe; se omite: %s\n' "./$name"
    # ln va en la condición: `set -e` abortaría el lote ante un fallo aislado.
    elif ln -s -- "$source" .; then
      linked=$((linked + 1))
    else
      failed=$((failed + 1))
      printf 'No se pudo enlazar: %s\n' "$source"
    fi
  done
  exec 3<&-

  lf -remote "send $id load"
  # echo persiste en la statline; printf se borra al terminar el comando.
  lf -remote "send $id echo Enlaces: $linked, omitidos: $omitted, fallidos: $failed"
}}
