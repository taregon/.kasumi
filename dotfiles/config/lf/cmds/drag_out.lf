# vim: filetype=config
# Abrir la ventana de arrastre con la selección, para soltarla en otro
# programa. Sigue siendo ripdrag y no dragon-drop: ripdrag fija el tamaño de
# la ventana y evita que un clic abra el archivo; dragon solo aporta -T.
# La ventana se dimensiona según la selección. La altura suma una fila por
# archivo, porque una ventana fija de 200 px con miniaturas de 195 dejaba un
# solo elemento a la vista y parecía que no cargó el resto. El ancho parte de
# la miniatura más el nombre más largo, porque los 400 px fijos dejaban un
# lienzo vacío a la derecha. Ambos tienen tope para no desbordar la pantalla.
# `%` deja lf usable mientras la ventana existe; el proceso termina al cerrarla.
cmd drag_out %{{
  names=(${(f)fs})
  count=${#names}
  icon=120

  # Nombre más largo, sin la ruta: el ancho depende de la etiqueta, no del
  # directorio. La variable no se llama path porque en zsh está ligada a PATH.
  # Los caracteres anchos (CJK, signos de ancho completo) ocupan unas dos
  # celdas: como en UTF-8 usan el doble de bytes que uno ASCII, el promedio
  # entre caracteres y bytes da la medida en celdas sin analizar cada rango.
  longest=0
  for name in ${names}; do
    base="${name##*/}"
    cells=${#base}
    if [[ $base == *[^[:ascii:]]* ]]; then
      bytes=$(print -rn -- "$base" | wc -c)
      cells=$(( (cells + bytes) / 2 ))
    fi
    if (( cells > longest )); then
      longest=$cells
    fi
  done

  # Ancho medido con Pango: ~7,3 px por carácter con la fuente por defecto
  # (6,3 en nombres de mayúsculas y 7,8 en los que llevan acentos o signos
  # anchos), más la miniatura y un margen mínimo. El margen se mantiene corto
  # porque ripdrag centra la etiqueta: cuanto más ancha la ventana, más se
  # desvía el texto del margen izquierdo.
  height=$(( count * icon + 24 ))
  width=$(( icon + longest * 73 / 10 + 12 ))
  if (( height > 600 )); then
    height=600
  fi
  if (( width < 240 )); then
    width=240
  fi
  if (( width > 700 )); then
    width=700
  fi

  # Los nombres base se resuelven contra el directorio actual; ripdrag los
  # muestra con -b y los recibe por stdin con -I.
  lf-basenames <<< "$fs" |
    ripdrag -W "$width" -H "$height" -s "$icon" -b -I
}}
