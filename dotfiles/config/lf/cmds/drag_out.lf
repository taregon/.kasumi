# vim: filetype=config
# Abrir la ventana de arrastre con la selección, para soltarla en otro
# programa. Sigue siendo ripdrag y no dragon-drop: ripdrag fija el tamaño de
# la ventana y evita que un clic abra el archivo; dragon solo aporta -T.
# La ventana se dimensiona según la selección. La altura suma una fila por
# archivo, porque una ventana fija de 200 px con miniaturas de 195 dejaba un
# solo elemento a la vista y parecía que no cargó el resto. El ancho parte de
# la miniatura más el nombre más largo, porque los 400 px fijos dejaban un
# lienzo vacío a la derecha. Ambos tienen tope para no desbordar la pantalla.
# `%` deja lf usable mientras la ventana existe; el proceso termina al cerrarla.
cmd drag_out %{{
  names=(${(f)fs})
  count=${#names}
  # ripdrag no acepta tamaño de letra: se lanza con un XDG_CONFIG_HOME propio
  # (drag-gtk/lista) que sube la etiqueta a 18 px, para que no quede diminuta
  # al lado de la miniatura. Ese CSS no alcanza al resto de apps GTK4.
  gtk_home="$HOME/.config/lf/drag-gtk/lista"
  # Fila = miniatura + 10 px de relleno. Con 195 px por fila solo cabía un
  # archivo en una ventana de 200; ahora las filas aprietan el contenido.
  icon=128
  row_padding=10
  # Separación vertical entre filas, igual que el margin del CSS de drag-gtk/lista.
  row_margin=8
  # Aire alrededor de la lista, igual que el padding del CSS de drag-gtk/lista.
  margin=12

  # Nombre más largo, sin la ruta: el ancho depende de la etiqueta, no del
  # directorio. La variable no se llama path porque en zsh está ligada a PATH.
  # Los caracteres anchos (CJK, signos de ancho completo) ocupan unas dos
  # celdas: como en UTF-8 usan el doble de bytes que uno ASCII, el promedio
  # entre caracteres y bytes da la medida en celdas sin analizar cada rango.
  longest=0
  for name in ${names}; do
    base="${name##*/}"
    cells=${#base}
    if [[ $base == *[^[:ascii:]]* ]]; then
      bytes=$(print -rn -- "$base" | wc -c)
      cells=$(( (cells + bytes) / 2 ))
    fi
    if (( cells > longest )); then
      longest=$cells
    fi
  done

  # Ancho medido con Pango a 18 px: ~9,4 px por carácter (9,15 de promedio,
  # con 8 en nombres de mayúsculas y 10 en los acentuados), más la miniatura
  # y un margen corto. El margen se mantiene corto porque ripdrag centra la
  # etiqueta: cuanto más ancha la ventana, más se desvía el texto del margen.
  height=$(( count * (icon + row_padding + row_margin) + margin * 2 ))
  width=$(( icon + longest * 94 / 10 + 16 + margin * 2 ))
  if (( height > 760 )); then
    height=760
  fi
  # Piso bajo para que una selección de nombres cortos no deje una ventana
  # más ancha que su texto, que ripdrag centraría.
  if (( width < 220 )); then
    width=220
  fi
  # Tope moderado: con nombres muy largos la ventana llegaba a 900 px y aun
  # así recortaba la etiqueta, así que crecía sin ganar legibilidad. Se corta
  # antes y el nombre completo queda en el tooltip de la fila.
  if (( width > 620 )); then
    width=620
  fi

  # Los nombres base se resuelven contra el directorio actual; ripdrag los
  # muestra con -b y los recibe por stdin con -I.
  lf-basenames <<< "$fs" |
    XDG_CONFIG_HOME="$gtk_home" ripdrag -W "$width" -H "$height" -s "$icon" -b -I
}}
