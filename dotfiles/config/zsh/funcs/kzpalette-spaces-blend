# vim: filetype=zsh
# Genera el degradado entre dos colores en el espacio elegido y lo emite
# como lista hexadecimal o como bloques con color.

setopt localoptions noksharrays

local color1="$1"
local color2="$2"
local steps="${3:-10}"
local space_arg="${4:-oklab}"
local view="${5:-}"
local -a gradient
local C_BLU C_RED C_RST canon lview lspace i

if [[ -t 1 ]]; then
    C_BLU=$'\033[0;34m'
    C_RED=$'\033[0;31m'
    C_RST=$'\033[0m'
else
    C_BLU=''
    C_RED=''
    C_RST=''
fi

if [[ "$color1" == "-h" || "$color1" == "--help" ]]; then
    printf '%s>>HELP Uso: kzpalette-spaces-blend <color> <color2> [pasos] [espacio] [vista]%s\n' "$C_BLU" "$C_RST"
    printf '  :: Argumentos\n'
    printf '      <color>     Color de origen\n'
    printf '      <color2>    Color de destino\n'
    printf '      [pasos]     Numero de pasos, entero >= 2 (defecto: 10)\n'
    printf '      [espacio]   rgb|hsl|lab|oklab|lch (defecto: oklab)\n'
    printf '      [vista]     block|set (defecto: block en terminal, set en pipe)\n'
    printf '  :: Vistas\n'
    printf '      block       Bloques con color del espacio elegido (defecto en terminal)\n'
    printf '      set         Tabla: hex (consumo agentico)\n'
    printf '                  Cabecera: >>INFO Columnas y >>INFO Espacio.\n'
    printf '  :: Notas\n'
    printf '      Ambas vistas interpolan solo el espacio indicado. block muestra\n'
    printf '      una fila por paso; set emite hex para filtrado.\n'
    printf '      -h, --help  Muestra esta ayuda\n'
    return 0
fi

# ──「 VALIDACION 」────────────────────────────────────────────
if [[ -z "$color1" || -z "$color2" ]]; then
    printf '%s>>FAIL Faltan colores de origen y destino.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Pasa <color> <color2>; usa -h para ver el uso.\n' >&2
    return 2
fi

if ! command -v pastel > /dev/null 2>&1; then
    printf '%s>>FAIL pastel no esta instalado.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Instala pastel para generar gradientes.\n' >&2
    return 1
fi

if [[ "$steps" != <-> ]]; then
    printf '%s>>FAIL Pasos no es un entero: %s.%s\n' "$C_RED" "$steps" "$C_RST" >&2
    printf '   Pasa un entero mayor o igual a 2.\n' >&2
    return 2
fi

if ((steps < 2)); then
    printf '%s>>FAIL Se requieren al menos 2 pasos.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Pasa un valor mayor o igual a 2.\n' >&2
    return 2
fi

lview="${view:l}"
if [[ -z "$lview" ]]; then
    if [[ -t 1 ]]; then
        lview='block'
    else
        lview='set'
    fi
fi
case "$lview" in
    block)
        lview='block'
        ;;
    set)
        lview='set'
        ;;
    *)
        printf '%s>>FAIL Vista invalida: %s.%s\n' "$C_RED" "$view" "$C_RST" >&2
        printf '   Usa block o set; usa -h para ver el uso.\n' >&2
        return 2
        ;;
esac

lspace="${space_arg:l}"
case "$lspace" in
    rgb)
        canon='RGB'
        ;;
    hsl)
        canon='HSL'
        ;;
    lab)
        canon='Lab'
        ;;
    oklab)
        canon='OkLab'
        ;;
    lch)
        canon='LCh'
        ;;
    *)
        printf '%s>>FAIL Espacio invalido: %s.%s\n' "$C_RED" "$space_arg" "$C_RST" >&2
        printf '   Usa rgb|hsl|lab|oklab|lch.\n' >&2
        return 2
        ;;
esac

# ──「 GENERACION 」────────────────────────────────────────────
# pastel gradient emite un color por linea; format hex normaliza la salida.
gradient=("${(@f)$(pastel gradient --colorspace "$canon" "$color1" "$color2" --number "$steps" | pastel format hex)}")
if ((${#gradient[@]} != steps)); then
    printf '%s>>FAIL gradiente vacio o incompleto en espacio %s.%s\n' "$C_RED" "$canon" "$C_RST" >&2
    printf '   Revisa los colores de origen y destino.\n' >&2
    return 1
fi

# ──「 VISTAS 」────────────────────────────────────────────────
case "$lview" in
    set)
        printf '>>INFO Columnas: hex\n'
        printf '>>INFO Espacio: %s\n' "$lspace"
        printf '%s\n' "${gradient[@]}"
        ;;
    block)
        # pastel paint -n no emite salto; cada fila cierra con un printf.
        for ((i = 1; i <= ${#gradient[@]}; i++)); do
            pastel paint -n "${gradient[i]}" "🮍███🮌 ${canon} ${gradient[i]} "
            printf '\n'
        done
        ;;
esac
