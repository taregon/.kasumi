# vim: filetype=zsh
# Genera una escala de 9 pasos (100-900) en Oklch con ancla movil.
# La conversion sRGB <-> Oklch la hace `pastel` (extra/pastel); la interpolacion
# polar y la inversion idempotente viven aqui.
#
# Metodo (Oklch de CSS Color 4, hue constante; matrices de Bjorn Ottosson):
# ancla en paso 200, progress = (step-200)/700, endpoint light = max(0.97, L0),
# endpoint dark = min(0.18, L0), C_step = C0 * (1-progress*0.5). La rampa es
# heuristica local, no parte de la norma: solo define conversion, hue powerless en
# acromaticos e interpolacion polar. Escala 100-900: convencion Material/Tailwind
# (posiciones de claro a oscuro, 500 como identidad); aqui 9 pasos sin 50/950 por
# decision local, sin apego estricto; ancla por defecto en 200 para tintes claros de
# fondo. Ancla movil: si A != 200 se invierte la formula para hallar el 200 implicito
# (C200 = CA/(1-progressA*0.5); L200 despejado por rama de endpoint validando su
# condicion); el ancla 900 se rechaza porque L900 = endpoint no determina L200 (ambiguo).
# Gamut: Oklch no tiene gamut, sRGB si; pastel recorta en vez de fallar, asi que el
# ajuste aproxima fitOklch reduciendo chroma (*0.9, hasta 24 intentos) hasta que el ida
# y vuelta via pastel coincide (tol L/C 0.004, hue 2 grados, hue libre en casi
# acromaticos). El fallback a C=0 siempre mapea porque el eje acromatico con
# L in [0,1] esta en gamut. Precision conocida (frontera de gamut de pastel): pasos en
# gamut exactos; extremo 900 +/-2 RGB; cromas altas con mismo hue pero chroma hasta
# ~0.015 mayor que la referencia a mitad de escala; idempotencia +/-1 RGB por redondeo
# a 4 decimales. Verificado contra la paleta kasumi local (verde y rojo).

setopt localoptions noksharrays

local color="${1:-}"
local anchor="${2:-200}"
local mode="${3:-dark}"
local view="${4:-}"
if [[ -t 1 ]]; then
    local -r C_BLU=$'\033[0;34m' C_RED=$'\033[0;31m' C_RST=$'\033[0m'
else
    local -r C_BLU='' C_RED='' C_RST=''
fi

local lview="${view:l}"
if [[ -z "$lview" ]]; then
    if [[ -t 1 ]]; then
        lview='d'
    else
        lview='s'
    fi
fi

case "$lview" in
    d | default | s | set | clean)
        ;;
    *)
        printf '%s>>FAIL Vista invalida: %s.%s\n' "$C_RED" "$view" "$C_RST" >&2
        printf '   Usa d (bloques) o clean (lista plana); -h para ver el uso.\n' >&2
        return 2
        ;;
esac

if [[ "$color" == "-h" || "$color" == "--help" ]]; then
    printf '%s>>HELP Uso: kzpastel-oklch-scale <color> [paso-ancla] [modo] [vista]%s\n' "$C_BLU" "$C_RST"
    printf '  :: Argumentos\n'
    printf '      <color>        Hex original, ej: #80c8a1\n'
    printf '      [paso-ancla]   Paso donde vive el color (100-800, defecto: 200)\n'
    printf '      [modo]         light|dark (defecto: dark)\n'
    printf '      [vista]        d|default|s|set|clean (defecto: d en terminal, s en pipe)\n'
    printf '  :: Vistas\n'
    printf '      d, default               Bloques con color por paso\n'
    printf '      s, set, clean            Lista hex plana (consumo agentico)\n'
    printf '  :: Notas\n'
    printf '      El ancla 900 no se admite: no deja pasos superiores e\n'
    printf '      impide reconstruir el 200 implicito (solucion ambigua).\n'
    printf '      La conversion Oklch la delega en pastel; la escala\n'
    printf '      usa interpolacion polar en Oklch con hue constante.\n'
    return 0
fi

if [[ -z "$color" ]]; then
    printf '%s>>FAIL Falta el color de origen.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Uso: kzpastel-oklch-scale <color> [paso-ancla] [modo] [vista].\n' >&2
    return 2
fi

if ! command -v pastel > /dev/null 2>&1; then
    printf '%s>>FAIL pastel no esta instalado.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Instala con: paru -S pastel.\n' >&2
    return 1
fi

if ! command -v python3 > /dev/null 2>&1; then
    printf '%s>>FAIL python3 no esta instalado.%s\n' "$C_RED" "$C_RST" >&2
    return 1
fi

local raw rc
raw="$(
    python3 - "$color" "$anchor" "$mode" << 'PY'
import re
import subprocess
import sys

# Trazabilidad: base y divisor de progress; endpoints de la rampa local;
# decaimiento de croma; intentos de ajuste; tolerancias del ida y vuelta.
BASE_STEP = 200
SPAN = 700.0
L_LIGHT = 0.97
L_DARK = 0.18
C_DECAY = 0.5
FIT_TRIES = 24
FIT_FACTOR = 0.9
TOL_L = 0.004
TOL_C = 0.004
TOL_H = 2.0
STEP_MIN = 100
STEP_MAX = 900
STEP = 100
HUE_MAX = 360.0

def run_pastel(*args):
    proc = subprocess.run(
        ["pastel", *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if proc.returncode != 0:
        raise SystemExit(f"pastel fallo: {proc.stderr.strip()}")
    return proc.stdout.strip()

OKLCH_RE = re.compile(
    r"oklch\(\s*([0-9.]+)\s*,?\s+([0-9.]+)\s*,?\s+([0-9.]+)\s*\)",
    re.IGNORECASE,
)

def to_oklch(color):
    out = run_pastel("format", "oklch", color)
    match = OKLCH_RE.search(out)
    if not match:
        raise SystemExit(f"No se pudo leer Oklch de {color}: {out}")
    return float(match.group(1)), float(match.group(2)), float(match.group(3))

def to_hex(l, c, h):
    l = min(1.0, max(0.0, l))
    c = max(0.0, c)
    h = h % HUE_MAX
    return run_pastel("format", "hex", f"oklch({l:.6f} {c:.6f} {h:.4f})")

def hue_distance(a, b):
    # 540 = HUE_MAX + 180: desplaza para medir distancia circular con signo.
    return abs(((a - b) % HUE_MAX + 540.0) % HUE_MAX - 180.0)

def fit_hex(l, c, h, l_tol=TOL_L, c_tol=TOL_C, h_tol=TOL_H):
    # Aproxima fitOklch de CSS Color 4: reduce chroma hasta que el ida y vuelta
    # via pastel coincida; pastel recorta gamut, no falla.
    l = min(1.0, max(0.0, l))
    c = max(0.0, c)
    h = h % HUE_MAX
    candidate = c
    for _ in range(FIT_TRIES):
        rendered = to_hex(l, candidate, h)
        bl, bc, bh = to_oklch(rendered)
        dl = abs(bl - l)
        dc = abs(bc - candidate)
        dh = hue_distance(bh, h)
        hue_ok = dh <= h_tol or candidate < 0.01 or bc < 0.005
        if dl <= l_tol and dc <= c_tol and hue_ok:
            return rendered
        candidate *= FIT_FACTOR
    return to_hex(l, 0.0, h)

color, anchor_raw, mode = sys.argv[1], sys.argv[2], sys.argv[3].lower()

try:
    anchor = int(anchor_raw)
except ValueError:
    raise SystemExit(f"Ancla invalida: {anchor_raw} (usa 100-800 en pasos de 100)")
if anchor not in range(STEP_MIN, STEP_MAX + 1, STEP):
    raise SystemExit(f"Ancla invalida: {anchor} (usa 100-800 en pasos de 100)")
if anchor == STEP_MAX:
    raise SystemExit("El ancla 900 no deja pasos superiores para interpolar")
if mode not in ("light", "dark"):
    raise SystemExit(f"Modo invalido: {mode} (usa light|dark)")

anchor_hex = run_pastel("format", "hex", color)
la, ca, ha = to_oklch(anchor_hex)

if anchor == BASE_STEP:
    l200, c200, h200 = la, ca, ha
else:
    progress_a = (anchor - BASE_STEP) / SPAN
    denom = 1.0 - progress_a
    c200 = ca / (1.0 - progress_a * C_DECAY)
    # Invierte LA = L200 + (endpoint(L200)-L200)*progressA por rama,
    # validando la condicion de la rama (max/min del endpoint).
    l200 = None
    if mode == "light":
        # Rama endpoint = L_LIGHT (vale si L200 < L_LIGHT).
        candidate = (la - L_LIGHT * progress_a) / denom
        if candidate < L_LIGHT:
            l200 = candidate
        else:
            # Rama endpoint = L200: entonces LA = L200.
            l200 = la
    else:
        # Rama endpoint = L_DARK (vale si L200 > L_DARK).
        candidate = (la - L_DARK * progress_a) / denom
        if candidate > L_DARK:
            l200 = candidate
        else:
            l200 = la
    h200 = ha

endpoint = max(L_LIGHT, l200) if mode == "light" else min(L_DARK, l200)

for step in range(STEP_MIN, STEP_MAX + 1, STEP):
    if step == anchor:
        print(f"{step} {anchor_hex}")
        continue
    progress = (step - BASE_STEP) / SPAN
    l = l200 + (endpoint - l200) * progress
    c = c200 * (1.0 - progress * C_DECAY)
    print(f"{step} {fit_hex(l, c, h200)}")
PY
)"
rc=$?
if ((rc != 0)); then
    return "$rc"
fi

# pastel paint -n no emite salto; cada fila cierra con un unico printf.
local line step hex
for line in "${(@f)raw}"; do
    step="${line%% *}"
    hex="${line##* }"
    case "$lview" in
        d | default)
            pastel paint -n "$hex" "🮍███🮌 ${step} ${hex} "
            printf '\n'
            ;;
        *)
            printf '%s %s\n' "$step" "$hex"
            ;;
    esac
done
