# vim: filetype=zsh
# Genera una escala base de 9 pasos (100-900), 11 con full (50-950), en Oklch.
# La conversion sRGB <-> Oklch la hace `pastel` (extra/pastel); la interpolacion
# polar y la inversion idempotente viven aqui.
#
# Metodo (Oklch de CSS Color 4, hue constante; matrices de Bjorn Ottosson):
# ancla en paso 200, progress = (step-200)/700, endpoint light = max(0.97, L0),
# endpoint dark = min(0.18, L0), C_step = C0 * (1-progress*0.5). La rampa es
# heuristica local, no parte de la norma: solo define conversion, hue powerless en
# acromaticos e interpolacion polar. Escala 50-950: convencion Material/Tailwind
# (posiciones de claro a oscuro, 500 como identidad); base de 9 pasos, full agrega
# 50 y 950 por decision local, sin apego estricto; pasos a 3 digitos (050) para no
# romper alineacion. Ancla por defecto en 200 para tintes claros de fondo.
# Ancla movil: si A != 200 se invierte la formula para hallar el 200 implicito
# (C200 = CA/(1-progressA*0.5); L200 despejado por rama de endpoint validando su
# condicion); las anclas 900 y 950 se rechazan porque no dejan pasos superiores
# (900 ambiguo: L900 = endpoint no determina L200). El 50 y el 950 extrapolan la rampa.
# Gamut: Oklch no tiene gamut, sRGB si; pastel recorta en vez de fallar, asi que el
# ajuste aproxima fitOklch reduciendo chroma (*0.9, hasta 24 intentos) hasta que el ida
# y vuelta via pastel coincide (tol L/C 0.004, hue 2 grados, hue libre en casi
# acromaticos). El fallback a C=0 siempre mapea porque el eje acromatico con
# L in [0,1] esta en gamut. Precision conocida (frontera de gamut de pastel): pasos en
# gamut exactos; extremo 900 (950 en full) +/-2 RGB; cromas altas con mismo hue pero
# chroma hasta ~0.015 mayor que la referencia a mitad de escala; idempotencia
# +/-1 RGB por redondeo a 4 decimales. Verificado contra la paleta kasumi local.
# (verde y rojo).
# La linea del ancla lleva [*] en ambas vistas (filtrable con grep).

setopt localoptions noksharrays

local color="${1:-}"
local anchor="${2:-200}"
local mode="${3:-dark}"
local view="${4:-}"
local extras="${5:-base}"
if [[ -t 1 ]]; then
    local -r C_BLU=$'\033[0;34m' C_RED=$'\033[0;31m' C_RST=$'\033[0m'
else
    local -r C_BLU='' C_RED='' C_RST=''
fi

local lview="${view:l}"
if [[ -z "$lview" ]]; then
    if [[ -t 1 ]]; then
        lview='block'
    else
        lview='set'
    fi
fi

case "$lview" in
    block | set)
        ;;
    *)
        printf '%s>>FAIL Vista invalida: %s.%s\n' "$C_RED" "$view" "$C_RST" >&2
        printf '   Usa block (bloques con color) o set (lista plana); -h para ver el uso.\n' >&2
        return 2
        ;;
esac

if [[ "$color" == "-h" || "$color" == "--help" ]]; then
    printf '%s>>HELP Uso: kzpastel-oklch-scale <color> [paso-ancla] [modo] [vista] [extras]%s\n' "$C_BLU" "$C_RST"
    printf '  :: Argumentos\n'
    printf '      <color>        Hex original, ej: #80c8a1\n'
    printf '      [paso-ancla]   Paso donde vive el color (defecto: 200; 50-800 en full)\n'
    printf '      [modo]         light|dark|l|d (defecto: dark)\n'
    printf '      [vista]        block|set (defecto: block en terminal, set en pipe)\n'
    printf '      [extras]       base|full (defecto: base; full agrega 50 y 950)\n'
    printf '  :: Vistas\n'
    printf '      block          Bloques con color por paso\n'
    printf '      set            Lista hex plana (consumo agentico)\n'
    printf '      Formato set:   PASO HEX CROMA a 3 digitos + [*] en el ancla\n'
    printf '  :: Notas\n'
    printf '      En block, C es la croma Oklch del paso.\n'
    printf '      Las anclas 900 y 950 no se admiten: no dejan pasos superiores ni\n'
    printf '      margen para reconstruir el 200 implicito (900 ambiguo).\n'
    printf '      La conversion Oklch la delega en pastel; la escala\n'
    printf '      usa interpolacion polar en Oklch con hue constante.\n'
    return 0
fi

if [[ -z "$color" ]]; then
    printf '%s>>FAIL Falta el color de origen.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Uso: kzpastel-oklch-scale <color> [paso-ancla] [modo] [vista] [extras].\n' >&2
    return 2
fi

if ! command -v pastel > /dev/null 2>&1; then
    printf '%s>>FAIL pastel no esta instalado.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Instala con: paru -S pastel.\n' >&2
    return 1
fi

if ! command -v python3 > /dev/null 2>&1; then
    printf '%s>>FAIL python3 no esta instalado.%s\n' "$C_RED" "$C_RST" >&2
    return 1
fi

local raw rc
raw="$(
    python3 - "$color" "$anchor" "$mode" "$extras" << 'PY'
import re
import subprocess
import sys

# Trazabilidad: base y divisor de progress; endpoints de la rampa local;
# decaimiento de croma; intentos de ajuste; tolerancias del ida y vuelta.
BASE_STEP = 200
SPAN = 700.0
L_LIGHT = 0.97
L_DARK = 0.18
C_DECAY = 0.5
FIT_TRIES = 24
FIT_FACTOR = 0.9
TOL_L = 0.004
TOL_C = 0.004
TOL_H = 2.0
# Escala base de 9 pasos; full agrega 50 y 950 (extremos de la rampa clasica).
BASE_STEPS = (100, 200, 300, 400, 500, 600, 700, 800, 900)
EXTRA_STEPS = (50, 950)
ANCHOR_MAX = 800
HUE_MAX = 360.0
# Abreviaturas de modo.
MODE_ABBR = {"l": "light", "d": "dark"}

def run_pastel(*args):
    proc = subprocess.run(
        ["pastel", *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if proc.returncode != 0:
        raise SystemExit(f"pastel fallo: {proc.stderr.strip()}")
    return proc.stdout.strip()

OKLCH_RE = re.compile(
    r"oklch\(\s*([0-9.]+)\s*,?\s+([0-9.]+)\s*,?\s+([0-9.]+)\s*\)",
    re.IGNORECASE,
)

def to_oklch(color):
    out = run_pastel("format", "oklch", color)
    match = OKLCH_RE.search(out)
    if not match:
        raise SystemExit(f"No se pudo leer Oklch de {color}: {out}")
    return float(match.group(1)), float(match.group(2)), float(match.group(3))

def to_hex(l, c, h):
    l = min(1.0, max(0.0, l))
    c = max(0.0, c)
    h = h % HUE_MAX
    return run_pastel("format", "hex", f"oklch({l:.6f} {c:.6f} {h:.4f})")

def hue_distance(a, b):
    # 540 = HUE_MAX + 180: desplaza para medir distancia circular con signo.
    return abs(((a - b) % HUE_MAX + 540.0) % HUE_MAX - 180.0)

def fit_hex(l, c, h, l_tol=TOL_L, c_tol=TOL_C, h_tol=TOL_H):
    # Aproxima fitOklch de CSS Color 4: reduce chroma hasta que el ida y vuelta
    # via pastel coincida; pastel recorta gamut, no falla. Devuelve (hex, croma).
    l = min(1.0, max(0.0, l))
    c = max(0.0, c)
    h = h % HUE_MAX
    candidate = c
    for _ in range(FIT_TRIES):
        rendered = to_hex(l, candidate, h)
        bl, bc, bh = to_oklch(rendered)
        dl = abs(bl - l)
        dc = abs(bc - candidate)
        dh = hue_distance(bh, h)
        hue_ok = dh <= h_tol or candidate < 0.01 or bc < 0.005
        if dl <= l_tol and dc <= c_tol and hue_ok:
            return rendered, candidate
        candidate *= FIT_FACTOR
    return to_hex(l, 0.0, h), 0.0

color, anchor_raw, mode = sys.argv[1], sys.argv[2], sys.argv[3].lower()
extras = sys.argv[4].lower() if len(sys.argv) > 4 else "base"
if extras not in ("base", "full"):
    raise SystemExit(f"Escala invalida: {extras} (usa base|full)")
STEPS = tuple(sorted(BASE_STEPS + EXTRA_STEPS)) if extras == "full" else BASE_STEPS
mode = MODE_ABBR.get(mode, mode)

try:
    anchor = int(anchor_raw)
except ValueError:
    raise SystemExit(f"Ancla invalida: {anchor_raw} (usa {STEPS[0]}-800 en pasos de 100)")
if anchor not in STEPS:
    raise SystemExit(f"Ancla invalida: {anchor} (usa {STEPS[0]}-800 en pasos de 100)")
if anchor > ANCHOR_MAX:
    raise SystemExit("Las anclas 900 y 950 no dejan pasos superiores para interpolar")
if mode not in ("light", "dark"):
    raise SystemExit(f"Modo invalido: {mode} (usa light|dark|l|d)")

anchor_hex = run_pastel("format", "hex", color)
la, ca, ha = to_oklch(anchor_hex)

if anchor == BASE_STEP:
    l200, c200, h200 = la, ca, ha
else:
    progress_a = (anchor - BASE_STEP) / SPAN
    denom = 1.0 - progress_a
    c200 = ca / (1.0 - progress_a * C_DECAY)
    # Invierte LA = L200 + (endpoint(L200)-L200)*progressA por rama,
    # validando la condicion de la rama (max/min del endpoint).
    l200 = None
    if mode == "light":
        # Rama endpoint = L_LIGHT (vale si L200 < L_LIGHT).
        candidate = (la - L_LIGHT * progress_a) / denom
        if candidate < L_LIGHT:
            l200 = candidate
        else:
            # Rama endpoint = L200: entonces LA = L200.
            l200 = la
    else:
        # Rama endpoint = L_DARK (vale si L200 > L_DARK).
        candidate = (la - L_DARK * progress_a) / denom
        if candidate > L_DARK:
            l200 = candidate
        else:
            l200 = la
    h200 = ha

endpoint = max(L_LIGHT, l200) if mode == "light" else min(L_DARK, l200)

for step in STEPS:
    if step == anchor:
        print(f"{step:03d} {anchor_hex} {ca:.3f}")
        continue
    progress = (step - BASE_STEP) / SPAN
    l = l200 + (endpoint - l200) * progress
    c = c200 * (1.0 - progress * C_DECAY)
    step_hex, step_c = fit_hex(l, c, h200)
    print(f"{step:03d} {step_hex} {step_c:.3f}")
PY
)"
rc=$?
if ((rc != 0)); then
    return "$rc"
fi

# pastel paint -n no emite salto; cada fila cierra con un unico printf.
# 10# fuerza base 10: los pasos vienen a 3 digitos y 050 seria octal.
local -r ICON=$'\uf4ee'
local line step hex rest chroma mark
for line in "${(@f)raw}"; do
    step="${line%% *}"
    rest="${line#* }"
    hex="${rest%% *}"
    chroma="${rest##* }"
    if ((10#$step == 10#$anchor)); then
        mark=' [*]'
    else
        mark=''
    fi
    case "$lview" in
        block)
            pastel paint -n "$hex" "▋  ${ICON}   Lorem ipsum dolor sit amet  │ Oklch ├── ${hex} ── C ${chroma} ── ${step} ──┤  🮍███🮌${mark} "
            printf '\n'
            ;;
        *)
            printf '%s %s %s%s\n' "$step" "$hex" "$chroma" "$mark"
            ;;
    esac
done
