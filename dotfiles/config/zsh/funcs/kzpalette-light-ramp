# vim: filetype=zsh
# Genera una rampa de color a partir de un color base variando su nivel
# de claridad mediante distintas propiedades de luminosidad disponibles
# en Pastel.
#
# Propiedades disponibles (mueven un escalar via `pastel set`; ninguna fija
# croma ni matiz, y pastel recorta fuera de gamut en vez de ajustar):
#   lightness     : propiedad 'lightness'; croma contenida y matiz acotado
#                   (medido: C 0.086-0.092, deriva H ~2 grados)
#   oklab-l       : componente L de OkLab, luminosidad perceptualmente uniforme
#                   (default); no fija C/h (medido: C 0.079-0.092, deriva H ~8 grados)
#   hsl-lightness : luminosidad HSL (geometrica, no perceptual); lava la croma
#                   en extremos y deriva el matiz (medido: C 0.010-0.118, deriva H ~8 grados)
# Medido sobre #80c8a1, rampa 30-96 en 5 pasos.
#
# La propiedad seleccionada se interpola linealmente entre los valores
# mínimo y máximo indicados, generando una secuencia de colores desde
# tonos más oscuros hasta tonos más claros del mismo color base.
# La interpolacion vive aqui (bc); la conversion y el recorte a gamut
# los delega en `pastel` (extra/pastel). La propiedad se resuelve una
# vez fuera del bucle porque es constante en la ejecucion.
#
# Uso: kzpalette-light-ramp <color> <min> <max> <pasos> [propiedad] [vista]
#   propiedad — lightness|l | oklab-l|o | hsl-lightness|hs (default: oklab-l)
#   vista     — block | set (default: block en terminal, set en pipe)
#
# Cada color generado se convierte a hexadecimal. En block se muestra como
# muestra coloreada; en set se emite la lista hex plana.

setopt localoptions noksharrays

local base="${1:-}"
local light_min="${2:-30}"
local light_max="${3:-96}"
local steps="${4:-20}"
local property="${5:-oklab-l}"
local view="${6:-}"
if [[ -t 1 ]]; then
    local -r C_BLU=$'\033[0;34m' C_RED=$'\033[0;31m' C_RST=$'\033[0m'
else
    local -r C_BLU='' C_RED='' C_RST=''
fi

# ──「 VALIDACION 」──────────────────────────────────────────
# Valida vista de ayuda, numericos y rango antes de tocar pastel o bc.
# Uso invalido en zsh devuelve 2; la dependencia ausente devuelve 1.
local num_re='^[0-9]+(\.[0-9]+)?$'
local int_re='^[0-9]+$'

# ──「 AYUDA 」───────────────────────────────────────────────
if [[ "$base" == "-h" || "$base" == "--help" ]]; then
    printf '%s>>HELP Uso: kzpalette-light-ramp <color> [min] [max] [pasos] [propiedad] [vista]%s\n' "$C_BLU" "$C_RST"
    printf '  :: Argumentos\n'
    printf '      <color>        Color base (hex, nombre o formato pastel)\n'
    printf '      [min]          Luminosidad inicial 0-100 (defecto: 30)\n'
    printf '      [max]          Luminosidad final 0-100 (defecto: 96)\n'
    printf '      [pasos]        Numero de pasos, entero >= 2 (defecto: 20)\n'
    printf '      [propiedad]    lightness|l | oklab-l|o | hsl-lightness|hs\n'
    printf '                     (defecto: oklab-l)\n'
    printf '      [vista]        block|set (defecto: block en terminal, set en pipe)\n'
    printf '  :: Propiedades\n'
    printf '      lightness      Propiedad lightness de pastel\n'
    printf '      oklab-l        Componente L de Oklab (0-100 se divide a 0.0-1.0)\n'
    printf '      hsl-lightness  Luminosidad HSL (0-100 se divide a 0.0-1.0)\n'
    printf '  :: Vistas\n'
    printf '      block          Bloques con color (defecto en terminal)\n'
    printf '      set            Lista hex plana (consumo agentico)\n'
    printf '  :: Notas\n'
    printf '      En block, cada paso muestra hex, %% aplicado y C (croma Oklch).\n'
    printf '      Las propiedades solo mueven luminosidad; no fijan croma ni matiz.\n'
    printf '      Oklch cilindrico (croma/hue): ver kzpalette-oklch-scale.\n'
    return 0
fi

if [[ -z "$base" ]]; then
    printf '%s>>FAIL Falta el color base.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Uso: kzpalette-light-ramp <color> [min] [max] [pasos] [propiedad] [vista].\n' >&2
    return 2
fi

if [[ ! "$light_min" =~ $num_re || ! "$light_max" =~ $num_re ]]; then
    printf '%s>>FAIL min y max deben ser numeros entre 0 y 100.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Recibido: min=%s max=%s.\n' "$light_min" "$light_max" >&2
    return 2
fi

if [[ ! "$steps" =~ $int_re ]]; then
    printf '%s>>FAIL pasos debe ser un entero mayor que 1.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Recibido: pasos=%s.\n' "$steps" >&2
    return 2
fi

((steps > 1)) || {
    printf '%s>>FAIL pasos debe ser mayor que 1.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Recibido: pasos=%s.\n' "$steps" >&2
    return 2
}

if (($(bc -l <<< "$light_min < 0 || $light_min > 100 || $light_max < 0 || $light_max > 100"))); then
    printf '%s>>FAIL min y max deben estar entre 0 y 100.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Recibido: min=%s max=%s.\n' "$light_min" "$light_max" >&2
    return 2
fi

if (($(bc -l <<< "$light_min >= $light_max"))); then
    printf '%s>>FAIL min debe ser menor que max.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Recibido: min=%s max=%s.\n' "$light_min" "$light_max" >&2
    return 2
fi

# ──「 DEPENDENCIAS 」────────────────────────────────────────
if ! command -v pastel > /dev/null 2>&1; then
    printf '%s>>FAIL pastel no esta instalado.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Instala con: paru -S pastel.\n' >&2
    return 1
fi

if ! command -v bc > /dev/null 2>&1; then
    printf '%s>>FAIL bc no esta instalado.%s\n' "$C_RED" "$C_RST" >&2
    printf '   Instala con: pacman -S bc.\n' >&2
    return 1
fi

# Normaliza la vista: block en terminal, set en pipe.
local lview="${view:l}"
if [[ -z "$lview" ]]; then
    if [[ -t 1 ]]; then
        lview='block'
    else
        lview='set'
    fi
fi

case "$lview" in
    block | set)
        ;;
    *)
        printf '%s>>FAIL Vista invalida: %s.%s\n' "$C_RED" "$view" "$C_RST" >&2
        printf '   Usa block (bloques con color) o set (lista plana); -h para ver el uso.\n' >&2
        return 2
        ;;
esac

# ──「 GENERACION 」──────────────────────────────────────────
# Resuelve la propiedad pastel una vez; el bucle solo interpola el
# escalar. oklab-l/hsl-lightness dividen a 0.0-1.0 porque pastel las
# espera normalizadas, mientras lightness trabaja en porcentaje directo.
local pastel_property label
case "$property" in
    lightness | l)
        pastel_property="lightness"
        label="Light"
        ;;
    oklab-l | o)
        pastel_property="oklab-l"
        label="Oklab"
        ;;
    hsl-lightness | hs)
        pastel_property="hsl-lightness"
        label="HSL L"
        ;;
    *)
        printf '%s>>FAIL Propiedad invalida: %s.%s\n' "$C_RED" "$property" "$C_RST" >&2
        printf '   Usa lightness|l | oklab-l|o | hsl-lightness|hs (defecto: oklab-l).\n' >&2
        return 2
        ;;
esac

local -r ICON=$'\uf4ee'
local i pct light_level light_pct hex_color oklch chroma
for ((i = 0; i < steps; i++)); do
    # Pct en 0-100 con 4 decimales; light_level adapta la escala que
    # pastel espera segun la propiedad ya resuelta.
    pct=$(bc -l <<< "scale=4; $light_min + $i * ($light_max - $light_min) / ($steps - 1)")
    case "$pastel_property" in
        lightness)
            light_level="$pct"
            ;;
        *)
            light_level=$(bc -l <<< "scale=4; $pct / 100")
            ;;
    esac
    light_pct=$(printf "%4.1f" "$pct")

    # Aplica el nivel al color base y convierte a hexadecimal; fail-stop
    # si pastel no reconoce el color (hex vacio).
    hex_color="$(pastel set "$pastel_property" "$light_level" "$base" | pastel format hex)"
    if [[ -z "$hex_color" ]]; then
        printf '%s>>FAIL pastel no genero color para %s.%s\n' "$C_RED" "$base" "$C_RST" >&2
        printf '   Revisa el color base y el nivel %s.\n' "$light_pct" >&2
        return 1
    fi

    if [[ "$lview" == 'block' ]]; then
        # Croma Oklch del color generado, por expansion (sin subshell extra
        # mas alla de la consulta a pastel); expone la perdida de saturacion.
        oklch="$(pastel format oklch "$hex_color")"
        chroma="${oklch#*, }"
        chroma="${chroma%%,*}"
        chroma="$(printf '%.3f' "$chroma")"

        # Muestra visual junto con el valor hexadecimal generado.
        pastel paint "$hex_color" \
            "▋  ${ICON}   Lorem ipsum dolor sit amet  │ $label ├── $hex_color ── $light_pct% ── C $chroma ──┤  🮍███🮌"
    else
        printf '%s\n' "$hex_color"
    fi
done
