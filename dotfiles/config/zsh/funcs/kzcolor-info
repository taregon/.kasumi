# vim: filetype=zsh
# Muestra informacion de un color (pastel + color.pizza).
# Salida humana por defecto; --json para consumo agentico (JSON compacto).
#
# Uso: kzcolor-info <color> [--json] [--list LIST]

emulate -L zsh
setopt localoptions noksharrays

local base=""
local json=0
local list="default"
local arg
local -a pos=()
for arg in "$@"; do
    case "$arg" in
        --json|--agent) json=1 ;;
        --list=*) list="${arg#--list=}" ;;
        --list) : ;;
        --*) ;;
        *) [[ -z "$base" ]] && base="$arg" || pos+=("$arg") ;;
    esac
done
local prev=""
for arg in "$@"; do
    if [[ "$prev" == "--list" ]]; then list="$arg"; prev=""; continue; fi
    case "$arg" in --list) prev="$arg" ;; esac
done
[[ -z "$base" && ${#pos[@]} -gt 0 ]] && base="${pos[1]}"

if [[ "$base" == "-h" || "$base" == "--help" ]]; then
    printf '>>HELP Uso: kzcolor-info <color> [--json] [--list LIST]\n'
    printf '  :: Que hace\n'
    printf '      Muestra informacion util de un color.\n'
    printf '  :: Argumentos\n'
    printf '      <color>     Color base (hex, nombre o formato pastel)\n'
    printf '      [--json]    Salida compacta para consumo agentico\n'
    printf '      [--list L]  Lista de color.pizza (defecto: default)\n'
    return 0
fi

if [[ -z "$base" ]]; then
    printf '>>FAIL Falta el color.\n' >&2
    printf '   Uso: kzcolor-info <color> [--json] [--list LIST].\n' >&2
    return 2
fi

if ! command -v pastel > /dev/null 2>&1; then
    printf '>>FAIL pastel no esta instalado.\n' >&2
    return 1
fi

# ── pastel (offline) ──────────────────────────────────────
local hex rgb hsl oklch
hex="$(pastel format hex "$base" 2>/dev/null)" || { printf '>>FAIL color invalido: %s.\n' "$base" >&2; return 2; }
rgb="$(pastel format rgb "$base" 2>/dev/null)"
hsl="$(pastel format hsl "$base" 2>/dev/null)"
oklch="$(pastel format oklch "$base" 2>/dev/null)"

# compactos (humanos)
local rgb_c="${rgb#rgb\(}"; rgb_c="${rgb_c%)}"
local hsl_c="${hsl#hsl\(}"; hsl_c="${hsl_c%)}"
local oklch_c="${oklch#OkLCh\(}"; oklch_c="${oklch_c%)}"

# ── color.pizza (local, opcional) ─────────────────────────
local p_name="" p_assigned="" p_distance="" p_lumwcag="" p_contrast="" p_adjectives=""
if command -v curl >/dev/null 2>&1 && command -v jaq >/dev/null 2>&1; then
    local hex_nohash="${hex#\#}"
    local resp
    resp="$(curl -sS -m 3 "http://127.0.0.1:8080/v1/?values=${hex_nohash}&list=${list}&description=true" 2>/dev/null)" || resp=""
    if [[ -n "$resp" ]]; then
        p_name="$(printf '%s' "$resp" | jaq -r '.colors[0].name // empty' 2>/dev/null)"
        p_assigned="$(printf '%s' "$resp" | jaq -r '.colors[0].hex // empty' 2>/dev/null)"
        p_distance="$(printf '%s' "$resp" | jaq -r '.colors[0].distance // empty' 2>/dev/null)"
        p_adjectives="$(printf '%s' "$resp" | jaq -c '.colors[0].description.adjectives // empty' 2>/dev/null)"
        # LUMWC y BEST se calculan localmente (formula WCAG), validado
        # contra pizza con diff <= 5e-7.
        local hr="${hex:1:2}" hg="${hex:3:2}" hb="${hex:5:2}"
        local rr=$((16#$hr)) gg=$((16#$hg)) bb=$((16#$hb))
        p_lumwcag="$(bc -l <<< "
scale=10
r=$rr/255; g=$gg/255; b=$bb/255
if (r <= 0.03928) rl=r/12.92 else rl=e(2.4*l((r+0.055)/1.055))
if (g <= 0.03928) gl=g/12.92 else gl=e(2.4*l((g+0.055)/1.055))
if (b <= 0.03928) bl=b/12.92 else bl=e(2.4*l((b+0.055)/1.055))
0.2126*rl + 0.7152*gl + 0.0722*bl
")"
        p_lumwcag="$(printf '%.5f' "$p_lumwcag")"
        if (( $(bc -l <<< "$p_lumwcag <= 0.179") )); then
            p_contrast="white"
        else
            p_contrast="black"
        fi
    fi
fi

# ── salida JSON (agentico) ────────────────────────────────
if (( json )); then
    printf '{"hex":"%s","name":"%s","rgb":"%s","hsl":"%s","oklch":"%s","luminanceWCAG":"%s","bestContrast":"%s","assigned_hex":"%s","distance":"%s","adjectives":%s}\n' \
        "$hex" "$p_name" \
        "$rgb" "$hsl" "$oklch" \
        "$p_lumwcag" "$p_contrast" \
        "$p_assigned" "$p_distance" \
        "${p_adjectives:-null}"
    return 0
fi

# ── salida humana (caja) ──────────────────────────────────
local name_disp="${p_name:-"-"}"
(( ${#name_disp} > 35 )) && name_disp="${name_disp[1,32]}..."

printf '╭──────────────────────────────────────╮\n'
printf '│  %-35s │\n' "$name_disp"
printf '├──────────────────────────────────────┤\n'
printf '│  %-36s│\n' "COLOR"
printf '│  %-10s %-25s│\n' "HEX" "$hex"
printf '│  %-10s %-25s│\n' "RGB" "$rgb_c"
printf '│  %-10s %-25s│\n' "HSL" "$hsl_c"
printf '│  %-10s %-25s│\n' "OKLCH" "$oklch_c"
printf '├──────────────────────────────────────┤\n'
printf '│  %-36s│\n' "PALETTE MATCH"
printf '│  %-10s %-25s│\n' "ASSIGNED" "${p_assigned:-"-"}"
printf '│  %-10s %-25s│\n' "DISTANCE" "${p_distance:-"-"}"
printf '├──────────────────────────────────────┤\n'
printf '│  %-36s│\n' "ACCESSIBILITY"
local contrast_disp="${p_contrast:-"-"}"
[[ "$contrast_disp" != "-" ]] && contrast_disp="${contrast_disp[1]:u}${contrast_disp[2,-1]}"
printf '│  %-10s %-25s│\n' "LUMINANCE" "${p_lumwcag:-"-"}"
printf '│  %-10s %-25s│\n' "CONTRAST" "$contrast_disp"
printf '╰──────────────────────────────────────╯\n'