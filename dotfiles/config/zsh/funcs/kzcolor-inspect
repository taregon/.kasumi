# vim: filetype=zsh
# Inspecciona un color y muestra sus coordenadas, el nombre asignado por
# color.pizza y su contraste WCAG. Salida humana por defecto; --json para
# consumo agentico.
#
# Uso: kzcolor-inspect <color> [--json] [--list LIST]
#   <color>       Hex, nombre o cualquier formato que acepte pastel
#   --json        JSON compacto de una linea (alias: --agent)
#   --list LIST   Lista de color.pizza (defecto: default)
#
# Requiere: pastel. color.pizza es opcional: sin curl, sin jaq o sin el
# servicio en 127.0.0.1:8080, los campos de nombre y descripcion quedan
# vacios y el resto se calcula igual.
# Niveles: >>HELP en stdout; >>FAIL en stderr.
# Codigos: 0 exito; 1 falta pastel; 2 uso invalido o color no parseable.

emulate -L zsh
setopt localoptions noksharrays

local -r USAGE='kzcolor-inspect <color> [--json] [--list LIST]'
local -r SERVICE='http://127.0.0.1:8080/v1/'
local -r SERVICE_TIMEOUT=3
local -r LIST_RE='^[A-Za-z0-9_-]+$'
# Umbral donde los ratios contra negro y blanco se igualan (WCAG 2.1); sobre
# el, el texto legible es negro.
local -r WCAG_FLIP=0.179
# Columnas del nombre en la caja; el recorte reserva 3 para los puntos.
local -r NAME_WIDTH=35
local -r NAME_PREVIEW=$((NAME_WIDTH - 3))

if [[ -t 1 ]]; then
    local -r C_BLU=$'\033[0;34m' C_RED=$'\033[0;31m' C_RST=$'\033[0m'
else
    local -r C_BLU='' C_RED='' C_RST=''
fi

# ──「 AYUDA 」───────────────────────────────────────────────
# Cuerpo unico de la ayuda: se emite a stdout con -h/--help y a stderr ante
# argumento faltante, para no duplicar el texto.
local -a help_lines
help_lines=(
    "${C_BLU}>>HELP Uso: ${USAGE}${C_RST}"
    '  :: Que hace'
    '      Muestra coordenadas, nombre y semantica, y contraste WCAG de un color.'
    '  :: Argumentos'
    '      <color>         Color base (hex, nombre o formato pastel)'
    '      --json          JSON compacto para consumo agentico (alias: --agent)'
    '      --list LIST     Lista de color.pizza (defecto: default)'
    '  :: Salida'
    '      Humana: caja con color, coincidencia de paleta y accesibilidad.'
    '      JSON: una linea con las claves hex, name, tagline, rgb, hsl, oklch,'
    '      complement, luminanceWCAG, bestContrast, contrast_ratio,'
    '      assigned_hex, distance, temperature, nouns y adjectives.'
    '      tagline y nouns solo se emiten en JSON.'
    '  :: Notas'
    '      color.pizza es opcional; sin el servicio los campos de nombre,'
    '      temperatura y coincidencia quedan vacios.'
    '      La temperatura es un indice CCT del dataset color-description:'
    '      orientativo, no una medicion fisica de la luz.'
)

# ──「 ARGUMENTOS 」──────────────────────────────────────────
# Parsea flags y operandos en una pasada; `--` corta la interpretacion de
# flags y todo lo posterior se toma como color.
local base='' json=0 list='default' help=0
local -a operands=()
while (($# > 0)); do
    case "$1" in
        -h | --help)
            help=1
            ;;
        --json | --agent)
            json=1
            ;;
        --list)
            shift
            if (($# == 0)); then
                printf '%s>>FAIL Falta el valor de --list.%s\n' "$C_RED" "$C_RST" >&2
                printf '   Uso: %s.\n' "$USAGE" >&2
                return 2
            fi
            list="$1"
            ;;
        --list=*)
            list="${1#--list=}"
            ;;
        --)
            shift
            operands+=("$@")
            break
            ;;
        -*)
            printf '%s>>FAIL Opcion desconocida: %s.%s\n' "$C_RED" "$1" "$C_RST" >&2
            printf '   Uso: %s.\n' "$USAGE" >&2
            return 2
            ;;
        *)
            operands+=("$1")
            ;;
    esac
    shift
done
base="${operands[1]:-}"

# ──「 AYUDA SOLICITADA 」────────────────────────────────────
if ((help)); then
    printf '%s\n' "${help_lines[@]}"
    return 0
fi

# ──「 VALIDACION 」──────────────────────────────────────────
if [[ -z "$base" ]]; then
    printf '%s>>FAIL Falta el color.%s\n' "$C_RED" "$C_RST" >&2
    printf '%s\n' "${help_lines[@]}" >&2
    return 2
fi

if ((${#operands[@]} > 1)); then
    printf '%s>>FAIL Sobra un argumento posicional: %s.%s\n' "$C_RED" "${operands[2]}" "$C_RST" >&2
    printf '   Uso: %s.\n' "$USAGE" >&2
    return 2
fi

# El nombre de lista viaja en la URL del servicio; se acota a caracteres
# seguros para no alterar la consulta.
if [[ ! "$list" =~ $LIST_RE ]]; then
    printf '%s>>FAIL Lista invalida: %s.%s\n' "$C_RED" "$list" "$C_RST" >&2
    printf '   Admitido: letras, digitos, guion y guion bajo.\n' >&2
    return 2
fi

# ──「 DEPENDENCIAS 」────────────────────────────────────────
if ! command -v pastel > /dev/null 2>&1; then
    printf '%s>>FAIL pastel no esta instalado.%s\n' "$C_RED" "$C_RST" >&2
    return 1
fi

# ──「 PASTEL 」──────────────────────────────────────────────
# La primera conversion valida el color; las siguientes ya no pueden fallar.
local hex out
out="$(pastel format hex "$base" 2>&1)" || {
    printf '%s>>FAIL color invalido: %s.%s\n' "$C_RED" "$base" "$C_RST" >&2
    printf '   pastel: %s\n' "${out%%$'\n'*}" >&2
    return 2
}
hex="$out"

local rgb hsl oklch
rgb="$(pastel format rgb "$base" 2> /dev/null)"
hsl="$(pastel format hsl "$base" 2> /dev/null)"
oklch="$(pastel format oklch "$base" 2> /dev/null)"
# Complementario (rotacion 180°).
local complement
complement="$(pastel rotate 180 "$hex" 2> /dev/null \
    | pastel format hex - 2> /dev/null)"

# Vistas compactas para la caja: se quita el nombre del espacio y el cierre.
local rgb_c="${rgb#rgb\(}"
rgb_c="${rgb_c%)}"
local hsl_c="${hsl#hsl\(}"
hsl_c="${hsl_c%)}"
local oklch_c="${oklch#OkLCh\(}"
oklch_c="${oklch_c%)}"

# ──「 COLOR.PIZZA 」─────────────────────────────────────────
# El servicio solo aporta nombre y descripcion; su ausencia no degrada las
# coordenadas ni el contraste, por eso no se emite aviso.
local name='' tagline='' assigned='' distance='' temperature='' adjectives='null' nouns='null'
if command -v curl > /dev/null 2>&1 && command -v jaq > /dev/null 2>&1; then
    local resp
    resp="$(curl -fsS -m "$SERVICE_TIMEOUT" \
        "${SERVICE}?values=${hex#\#}&list=${list}&description=true" 2> /dev/null)" || resp=''
    if [[ -n "$resp" ]]; then
        name="$(printf '%s' "$resp" | jaq -r '.colors[0].name // empty' 2> /dev/null)"
        tagline="$(printf '%s' "$resp" | jaq -r '.colors[0].tagline // empty' 2> /dev/null)"
        assigned="$(printf '%s' "$resp" | jaq -r '.colors[0].hex // empty' 2> /dev/null)"
        distance="$(printf '%s' "$resp" | jaq -r '.colors[0].distance // empty' 2> /dev/null)"
        adjectives="$(printf '%s' "$resp" \
            | jaq -c '.colors[0].description.adjectives // empty' 2> /dev/null)"
        adjectives="${adjectives:-null}"
        # NOTA: nouns solo se emite en JSON (--json). No se muestra en la
        # vista humana por verbosidad; no agregarlo a la caja.
        nouns="$(printf '%s' "$resp" \
            | jaq -c '.colors[0].description.nouns // empty' 2> /dev/null)"
        nouns="${nouns:-null}"

        # Indice CCT correlacionado del dataset, orientativo: no mide la luz.
        local temp_desc temp_value
        temp_desc="$(printf '%s' "$resp" | jaq -r \
            '.colors[0].description.temperature.descriptive // [] | join(", ")' \
            2> /dev/null)"
        temp_value="$(printf '%s' "$resp" | jaq -r \
            '.colors[0].description.temperature.value // empty' 2> /dev/null)"
        if [[ -n "$temp_desc" && -n "$temp_value" ]]; then
            temperature="${temp_desc} (${temp_value})"
        elif [[ -n "$temp_desc" ]]; then
            temperature="$temp_desc"
        elif [[ -n "$temp_value" ]]; then
            temperature="$temp_value"
        fi
    fi
fi

# ──「 ACCESIBILIDAD 」───────────────────────────────────────
# Formula WCAG 2.1 sobre sRGB; se elige texto blanco o negro por contraste.
# Se trunca a dos decimales en vez de redondear: nunca informa un ratio mayor
# que el real y reproduce la salida historica de bc. Validado contra
# color.pizza con diferencia <= 5e-7.
local hr="${hex:1:2}" hg="${hex:3:2}" hb="${hex:5:2}"
local rr=$((16#$hr)) gg=$((16#$hg)) bb=$((16#$hb))
local wcag
wcag="$(awk -v r="$rr" -v g="$gg" -v b="$bb" -v flip="$WCAG_FLIP" 'BEGIN {
    r /= 255; g /= 255; b /= 255
    rl = (r <= 0.03928) ? r / 12.92 : ((r + 0.055) / 1.055) ^ 2.4
    gl = (g <= 0.03928) ? g / 12.92 : ((g + 0.055) / 1.055) ^ 2.4
    bl = (b <= 0.03928) ? b / 12.92 : ((b + 0.055) / 1.055) ^ 2.4
    lum = 0.2126 * rl + 0.7152 * gl + 0.0722 * bl
    if (lum <= flip) { text = "white"; ratio = 1.05 / (lum + 0.05) }
    else { text = "black"; ratio = (lum + 0.05) / 0.05 }
    printf "%.5f %s %.2f\n", lum, text, int(ratio * 100) / 100
}')"
local -a wcag_field=(${=wcag})
local luminance="${wcag_field[1]}" contrast="${wcag_field[2]}" ratio="${wcag_field[3]}:1"

# ──「 SALIDA JSON 」─────────────────────────────────────────
if ((json)); then
    # Los textos libres se escapan porque el dataset puede incluir comillas.
    local e_name="${name//\\/\\\\}"
    e_name="${e_name//\"/\\\"}"
    e_name="${e_name//$'\n'/\\n}"
    local e_tagline="${tagline//\\/\\\\}"
    e_tagline="${e_tagline//\"/\\\"}"
    e_tagline="${e_tagline//$'\n'/\\n}"
    local e_temperature="${temperature//\\/\\\\}"
    e_temperature="${e_temperature//\"/\\\"}"
    e_temperature="${e_temperature//$'\n'/\\n}"

    printf '{"hex":"%s","name":"%s","tagline":"%s",''"rgb":"%s","hsl":"%s","oklch":"%s","complement":"%s",''"luminanceWCAG":"%s","bestContrast":"%s","contrast_ratio":"%s",''"assigned_hex":"%s","distance":"%s","temperature":"%s",''"nouns":%s,"adjectives":%s}\n' \
        "$hex" "$e_name" "$e_tagline" \
        "$rgb" "$hsl" "$oklch" "$complement" \
        "$luminance" "$contrast" "$ratio" \
        "$assigned" "$distance" "$e_temperature" \
        "$nouns" "$adjectives"
    return 0
fi

# ──「 SALIDA HUMANA 」───────────────────────────────────────
# La caja mantiene 38 columnas interiores: 2 de margen, 10 de rotulo y 25
# de valor, mas el espacio de cierre. tagline y nouns se omiten por
# verbosidad: solo viajan en JSON.
# Helper de render; autoload perezoso para no depender del orden de carga.
if ! whence -w _kzcolor-swatch > /dev/null 2>&1; then
    autoload -Uz _kzcolor-swatch
fi
local name_disp="${name:-"-"}"
((${#name_disp} > NAME_WIDTH)) && name_disp="${name_disp[1,NAME_PREVIEW]}..."
local contrast_disp="${contrast[1]:u}${contrast[2,-1]}"

printf '╭──────────────────────────────────────╮\n'
printf '│  %-*s │\n' "$NAME_WIDTH" "$name_disp"
printf '├──────────────────────────────────────┤\n'
printf '│  %-36s│\n' "COLOR"
printf '│  %-10s ' "HEX"
_kzcolor-swatch "$hex" "$contrast"
printf '│\n'
printf '│  %-10s %-25s│\n' "RGB" "$rgb_c"
printf '│  %-10s %-25s│\n' "HSL" "$hsl_c"
printf '│  %-10s %-25s│\n' "OKLCH" "$oklch_c"
printf '│  %-10s ' "COMPLEMENT"
_kzcolor-swatch "$complement"
printf '│\n'
printf '├──────────────────────────────────────┤\n'
printf '│  %-36s│\n' "PALETTE MATCH"
if [[ -n "$assigned" ]]; then
    printf '│  %-10s ' "ASSIGNED"
    _kzcolor-swatch "$assigned"
    printf '│\n'
else
    printf '│  %-10s %-25s│\n' "ASSIGNED" "-"
fi
printf '│  %-10s %-25s│\n' "DISTANCE" "${distance:-"-"}"
printf '├──────────────────────────────────────┤\n'
printf '│  %-36s│\n' "ACCESSIBILITY"
printf '│  %-10s %-25s│\n' "LUMINANCE" "$luminance"
printf '│  %-10s %-25s│\n' "CONTRAST" "$contrast_disp"
printf '│  %-10s %-25s│\n' "TEMP" "${temperature:-"-"}"
printf '│  %-10s %-25s│\n' "CRATIO" "$ratio"
printf '╰──────────────────────────────────────╯\n'
