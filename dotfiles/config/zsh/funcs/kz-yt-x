# vim: filetype=zsh
# yt-dlp para X/Twitter con cookies del navegador.
# Soporta tweets privados extrayendo cookies de Firefox.
# Prioriza MP4 + M4A.
# Valida enlaces con httpx en paralelo y reporta solo los rotos:
#   ::ERR:: <code> - <link>  (4xx/5xx o sin respuesta 000)
# Incluye impersonacion, sleep aleatorio y reintentos para evitar bloqueos.
# Videos ya descargados se omiten automaticamente (--download-archive).
# Trunca titulo a 120 bytes (~40 caracteres CJK) para filesystem.
#
# Uso: kz-yt-x <url>
#      kz-yt-x -a <archivo_de_enlaces>

local browser="firefox"

# Navegador: firefox, chrome, chromium, brave, edge, opera, vivaldi, whale
# Ruta opaca: evitar revelar que es un archive de descargas.
local archive_file="$HOME/.cache/.d4ta/t"

local -a yt_args=(
    # Auth y anti-bloqueo
    --cookies-from-browser "$browser"
    --download-archive "$archive_file"
    --no-overwrites
    --impersonate chrome
    --sleep-requests 0.5
    --sleep-interval 1
    --max-sleep-interval 3
    --retries 3
    --fragment-retries 5
    --ignore-errors
    --xff default
    # Video prioritario MP4
    -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best"
    --merge-output-format mp4
    --windows-filenames
    -o "%(webpage_url_domain)s [%(id)s] %(uploader)s - %(title).120B.%(ext)s"
)

mkdir -p "${archive_file:h}"

local -a targets
if [[ "$1" == "-a" || "$1" == "--batch-file" ]]; then
    targets=("${(@f)$(sed -e '/^[[:space:]]*$/d' -e '/^[[:space:]]*#/d' -e 's/\r$//' "$2")}")
else
    targets=("$@")
fi

local tmp_httpx url code
tmp_httpx=$(mktemp)
printf '%s\n' "${targets[@]}" \
    | httpx-toolkit -silent -json -timeout 6 -t 20 -nfs -ob -rstr 1024 > "$tmp_httpx"

local -a valid_links
for url in "${targets[@]}"; do
    code=$(jaq -r --arg u "$url" 'first(select(.url == $u) | .status_code)' "$tmp_httpx")
    code=${code:-000}
    if [[ "$code" == [23][0-9][0-9] ]]; then
        valid_links+=("$url")
    else
        echo "ERR $code - $url" >&2
    fi
done
rm -f "$tmp_httpx"

if ((${#valid_links} == 0)); then
    echo "Ningun enlace valido" >&2
    return 1
fi
yt-dlp "${yt_args[@]}" "${valid_links[@]}"
