# vim: filetype=zsh
# yt-dlp para X/Twitter con cookies del navegador.
# Soporta tweets privados extrayendo cookies de Firefox.
# Prioriza MP4 + M4A.
# Valida enlaces con httpx en paralelo y reporta lo que no descarga:
#   ~> FAIL <code> - <link>     (3xx nomedia, 4xx/5xx o sin respuesta 000)
#   ~> FAIL nomedia - <link>   (tweet sin video nativo)
#   ~> FAIL profile - <link>    (URL de perfil, no de tweet)
# Incluye impersonacion, sleep aleatorio y reintentos para evitar bloqueos.
# Videos ya descargados se omiten automaticamente (--download-archive).
# Trunca titulo a 120 bytes (~40 caracteres CJK) para filesystem.
#
# Uso: kz-yt-x <url>
#      kz-yt-x -a <archivo_de_enlaces>

# Navegador: firefox, chrome, chromium, brave, edge, opera, vivaldi, whale
readonly BROWSER="firefox"

# Ruta opaca: evitar revelar que es un archive de descargas.
readonly ARCHIVE_FILE="$HOME/.cache/.d4ta/t"

# shell-colors: C_BLU=STEP/HELP, C_YEL=INFO/FAIL/WARN, C_GRN=PASS.
# Solo los >>NIVEL llevan color; los anidados ~> FAIL van en plano.
readonly C_BLU=$'\033[0;34m' C_YEL=$'\033[0;33m' C_GRN=$'\033[0;32m' C_RST=$'\033[0m'

# Dependencias externas requeridas: fallo temprano y sin ruido si faltan.
local dep
for dep in httpx-toolkit jaq curl ugrep yt-dlp; do
    if ! command -v "$dep" > /dev/null 2>&1; then
        printf '%s>>FAIL Falta %s.%s\n' "$C_YEL" "$dep" "$C_RST" >&2
        return 1
    fi
done

local -a yt_args=(
    # Auth y anti-bloqueo
    --cookies-from-browser "$BROWSER"
    --download-archive "$ARCHIVE_FILE"
    --no-overwrites
    --sleep-requests 0.5
    --sleep-interval 1
    --max-sleep-interval 3
    --retries 3
    --fragment-retries 5
    --ignore-errors
    --xff default
    # Video prioritario MP4
    -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best"
    --merge-output-format mp4
    --windows-filenames
    -o "%(webpage_url_domain)s [%(id)s] %(uploader)s - %(title).120B.%(ext)s"
)
# Impersonate requiere curl_cffi compatible; versiones incompatibles
# lo marcan unavailable y abortan. Se verifica soporte antes de usar.
if yt-dlp --list-impersonate-targets 2>&1 | ugrep -q 'Chrome.*curl_cffi.*unavailable'; then
    printf '%s>>INFO Omitiendo impersonate (curl_cffi incompatible).%s\n' "$C_YEL" "$C_RST"
else
    yt_args+=(--impersonate chrome)
fi

mkdir -p "${ARCHIVE_FILE:h}"

local -a targets
if [[ "$1" == "-a" || "$1" == "--batch-file" ]]; then
    local batch_file="${2:?Archivo requerido con -a}"
    # Diagnostico directo: el archivo debe existir para leerlo.
    if [[ ! -f "$batch_file" ]]; then
        printf '%s>>FAIL %s no existe.%s\n' "$C_YEL" "$batch_file" "$C_RST" >&2
        return 1
    fi
    # Sed: elimina lineas vacías, comentarios y carriage returns.
    targets=("${(@f)$(sed -e '/^[[:space:]]*$/d' \
        -e '/^[[:space:]]*#/d' \
        -e 's/\r$//' \
        "$batch_file" 2> /dev/null)}")
else
    targets=("$@")
fi

# Sin argumentos o sin enlaces en el archivo: sin trabajo, sin probes.
# Sed vacio deja un elemento vacio (longitud 1), por eso se mira el primero.
if [[ -z "${targets[1]:-}" ]]; then
    printf '%s>>HELP Uso: kz-yt-x <url>  |  kz-yt-x -a <archivo_de_enlaces>%s\n' "$C_BLU" "$C_RST"
    return 0
fi

# ──「 Limpieza De Urls 」────────────────────────────────────
# Enlaces de share de X llevan query de tracking (?t=...&s=09) que no
# afecta a la descarga; se descarta para pasar la URL canonica a yt-dlp.
# Un perfil (x.com/<usuario>) no tiene tweet descargable; se marca ERR
# profile y se descarta antes de gastar un probe en httpx.
local raw_url clean_url
local -a clean_targets
printf '%s>>STEP [1/3] Depurando URLs...%s\n' "$C_BLU" "$C_RST"
for raw_url in "${targets[@]}"; do
    clean_url="$raw_url"
    if [[ "$raw_url" == *x.com/* || "$raw_url" == *twitter.com/* ]]; then
        clean_url="${raw_url%%[?#]*}"
        if [[ "$clean_url" != */status/* ]]; then
            printf "   ~> FAIL profile - %s\n" "$clean_url"
            continue
        fi
    fi
    clean_targets+=("$clean_url")
done
targets=("${clean_targets[@]}")

# Sin enlaces tras descartar perfiles: no hay nada que probar ni descargar.
if ((${#targets} == 0)); then
    printf '%s>>FAIL Ningún enlace válido.%s\n' "$C_YEL" "$C_RST" >&2
    return 1
fi

local tmpdir url code
tmpdir=$(mktemp -d)
# Limpieza garantizada del temporal en cualquier salida de la funcion.
trap 'rm -rf "$tmpdir"' EXIT
printf '%s\n' "${targets[@]}" \
    | httpx-toolkit -silent -json -duc -nc -timeout 6 -t 20 -nfs -ob -rstr 1024 > "$tmpdir/probe"

local -a valid_links
printf '%s>>STEP [2/3] Validando %d enlaces con httpx...%s\n' "$C_BLU" "${#targets[@]}" "$C_RST"
for url in "${targets[@]}"; do
    # Sin match en el JSON, first() emite vacio y ${code:-000} fija 000.
    code=$(jaq -r --arg u "$url" 'first(select(.url == $u) | .status_code)' "$tmpdir/probe")
    code=${code:-000}
    # Solo 2xx descarga: un nomedia (3xx) no tiene video nativo y quedaria
    # deudor en yt-dlp; se reporta el codigo numerico (ERR <code>) en plano
    if [[ "$code" == 2[0-9][0-9] ]]; then
        valid_links+=("$url")
    else
        printf "   ~> FAIL %s - %s\n" "$code" "$url"
    fi
done

# ──「 Filtro De Redireccion Externa 」───────────────────────
# Tweets que solo enlazan a otro sitio (link-posts) o no tienen video
# nativo: yt-dlp intentaria seguir el enlace externo y no descargaria.
# La syndication publica de X devuelve el media del tweet por ID, sin auth.
local syn_json syn_verdict syn_id
local -a final_links
printf '%s>>STEP [3/3] Filtrando %d enlaces validados...%s\n' "$C_BLU" "${#valid_links[@]}" "$C_RST"
for url in "${valid_links[@]}"; do
    syn_id="${url##*/status/}"
    syn_id="${syn_id%%/*}"
    if [[ "$syn_id" != <-> ]]; then
        final_links+=("$url")
        continue
    fi
    syn_json=$(curl -s -m 6 -A 'Mozilla/5.0' \
        "https://cdn.syndication.twimg.com/tweet-result?id=$syn_id&lang=en&token=a")
    syn_verdict=$(jaq -r 'if .__typename == "Tweet" then
        ([.mediaDetails[]?.type] | (index("video") != null or index("animated_gif") != null))
        else "ambig" end' <<< "$syn_json" 2> /dev/null)
    # Fallo de red o respuesta no parseable: se deja pasar (fail-open)
    # para no descartar tweets privados, que la syndication no expone.
    if [[ "$syn_verdict" == "false" ]]; then
        printf "   ~> FAIL nomedia - %s\n" "$url"
    else
        final_links+=("$url")
    fi
done

if ((${#final_links} == 0)); then
    printf '%s>>FAIL Ningún enlace válido.%s\n' "$C_YEL" "$C_RST" >&2
    return 1
fi
if yt-dlp "${yt_args[@]}" "${final_links[@]}"; then
    printf '%s>>PASS Descarga completada.%s\n' "$C_GRN" "$C_RST"
    return 0
else
    printf '%s>>WARN yt-dlp fallo en una parte de los enlaces; los descargados se conservan.%s\n' "$C_YEL" "$C_RST" >&2
    return 1
fi
