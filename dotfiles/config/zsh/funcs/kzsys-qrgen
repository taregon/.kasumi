# vim: filetype=zsh
# Genera un código QR como PNG desde texto o entrada estándar.
# La salida se guarda en el directorio actual con nombre de fecha y hora.
#
# Uso: kzsys-qrgen <texto>        -> QR desde texto literal
#      kzsys-qrgen < archivo.txt  -> QR desde contenido de un archivo
#
# Más info: https://www.howtogeek.com/devops/how-to-create-qr-codes-from-the-linux-command-line/

# Colores ANSI para niveles raíz; sub-tareas (~>) y notas van sin color.
readonly C_BLU=$'\033[0;34m' C_YEL=$'\033[0;33m' C_GRN=$'\033[0;32m' C_RED=$'\033[0;31m' C_RST=$'\033[0m'

# Validación de dependencias al inicio: fallo temprano y consistente.
if ! command -v qrencode &> /dev/null; then
    printf '%s>>FAIL qrencode no está instalado.%s\n' "$C_RED" "$C_RST" >&2
    printf '   > Instala qrencode con el gestor de paquetes.\n' >&2
    return 1
fi

# Sin argumento y con stdin interactivo no hay datos que codificar.
if [[ -z "$1" && -t 0 ]]; then
    printf '%s>>HELP Uso: kzsys-qrgen <texto> | kzsys-qrgen < archivo.txt%s\n' "$C_BLU" "$C_RST"
    printf '  :: Genera un QR PNG desde texto o entrada estándar.\n'
    return 0
fi

# qrencode lee de stdin solo cuando no recibe el dato como argumento.
local -a data=()
[[ -n "$1" ]] && data=("$1")

local outfile
outfile="$(date +'qrcode_%F_%H%M%S').png"

if ! qrencode \
    --background=faedeb \
    --foreground=9b044c \
    -s 16 \
    -m 2 \
    -l M \
    -o "$outfile" \
    "$data[@]"; then
    printf '%s>>FAIL qrencode falló.%s\n' "$C_RED" "$C_RST" >&2
    printf '   > Revisa el texto de entrada o los permisos del directorio.\n' >&2
    return 1
fi

# Verificar el efecto secundario: el comando puede terminar sin producir la salida.
if [[ -f "$outfile" ]]; then
    printf '%s>>PASS generado: %s%s\n' "$C_GRN" "$outfile" "$C_RST"
    return 0
fi

printf '%s>>FAIL No se generó el archivo de salida.%s\n' "$C_RED" "$C_RST" >&2
return 1
