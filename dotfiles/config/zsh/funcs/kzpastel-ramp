# vim: filetype=zsh
# Genera una rampa de color a partir de un color base variando su nivel
# de claridad mediante distintas propiedades de luminosidad disponibles
# en Pastel.
#
# Modos disponibles (mueven un escalar via `pastel set`; ningun modo fija
# croma ni matiz, y pastel recorta fuera de gamut en vez de ajustar):
#   l : propiedad 'lightness'; croma contenida y matiz acotado
#       (medido: C 0.086-0.092, deriva H ~2 grados)
#   o : componente L de OkLab, luminosidad perceptualmente uniforme
#       (default); no fija C/h (medido: C 0.079-0.092, deriva H ~8 grados)
#   h : luminosidad HSL (geometrica, no perceptual); lava la croma en
#       extremos y deriva el matiz (medido: C 0.010-0.118, deriva H ~8 grados)
# Medido sobre #80c8a1, rampa 30-96 en 5 pasos.
#
# La propiedad seleccionada se interpola linealmente entre los valores
# mínimo y máximo indicados, generando una secuencia de colores desde
# tonos más oscuros hasta tonos más claros del mismo color base.
#
# Uso: kzpastel-ramp <color> <min> <max> <pasos> [modo]
#   modo — l | o | h (default: o)
#
# Cada color generado se convierte a hexadecimal y se muestra como una
# muestra coloreada directamente en la terminal.

local base="$1"
local light_min="${2:-30}"
local light_max="${3:-96}"
local steps="${4:-20}"
local mode="${5:-o}"
local hex_color property label light_level light_pct oklch chroma

[[ -z "$base" || -z "$steps" ]] && {
    echo "Uso: kzpastel-ramp <color> <min> <max> <pasos> [modo]"
    echo "  modo: l=lightness | o=oklab-l | h=hsl-lightness (default: o)"
    echo "  %: nivel de luminosidad aplicado (min-max)"
    echo "  C: croma Oklch del color generado"
    echo "  modos l/o/h: solo mueven luminosidad; no fijan croma ni matiz"
    echo "  Oklch cilindrico (croma/hue): ver kzpastel-oklch-scale"
    return 1
}

((steps > 1)) || {
    echo "Se requieren al menos 2 pasos"
    return 1
}

((light_min >= 0 && light_max <= 100)) || {
    echo "min y max deben estar entre 0 y 100"
    return 1
}

# Generar cada color de la escala.
for ((i = 0; i < steps; i++)); do
    case "$mode" in

        l)
            # Interpolación utilizando la propiedad genérica 'lightness'
            # expuesta por Pastel. Esta propiedad produce resultados distintos
            # a la componente L de Oklab.
            light_level=$(bc -l <<< \
                "scale=4; $light_min + $i * ($light_max - $light_min) / ($steps - 1)")

            light_pct=$(printf "%4.1f" "$light_level")

            property="lightness"
            label="Light"
            ;;

        o)
            # Interpolación utilizando la componente L de Oklab.
            # Oklab emplea una escala normalizada, por lo que el nivel de
            # luminosidad se convierte posteriormente de porcentaje (0–100)
            # a un valor decimal (0.0–1.0).
            light_level=$(bc -l <<< \
                "scale=4; ($light_min + $i * ($light_max - $light_min) / ($steps - 1)) / 100")

            light_pct=$(printf "%4.1f" "$(bc -l <<< "$light_level * 100")")

            property="oklab-l"
            label="Oklab"
            ;;

        h)
            # HSL-lightness es una transformación geométrica sobre RGB,
            # no un modelo perceptual. Incrementos iguales de lightness
            # no producen saltos visuales uniformes de claridad.
            light_level=$(bc -l <<< \
                "scale=4; ($light_min + $i * ($light_max - $light_min) / ($steps - 1)) / 100")

            light_pct=$(printf "%4.1f" "$(bc -l <<< "$light_level * 100")")

            property="hsl-lightness"
            label="HSL L"
            ;;

        *)
            echo "Modo inválido: $mode"
            return 1
            ;;
    esac

    # Aplicar el nivel de luminosidad calculado al color base y
    # convertir el resultado a formato hexadecimal.
    hex_color=$(
        pastel set "$property" "$light_level" "$base" \
            | pastel format hex
    )

    # Croma Oklch del color generado, por expansion (sin subshell extra
    # mas alla de la consulta a pastel); expone la perdida de saturacion.
    oklch="$(pastel format oklch "$hex_color")"
    chroma="${oklch#*, }"
    chroma="${chroma%%,*}"
    chroma="$(printf '%.3f' "$chroma")"

    # Mostrar una muestra visual junto con el valor hexadecimal generado.
    pastel paint "$hex_color" \
        "▋     Lorem ipsum dolor sit amet  │ $label ├── $hex_color ── $light_pct% ── C $chroma ──┤  🮍███🮌"

done
