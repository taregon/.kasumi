#!/usr/bin/env bash
# Rota wallpapers en Sway via awww cada 20s con transición fade.
# Si awww no está instalado, sale sin error. Si el directorio de wallpapers
# está ausente o vacío, genera [NO IMAGE] en cache (requiere magick/timeout).
# Env: KASUMI_WALLPAPERS_DIR; ver estado con: awww query
# ╒══════════════════════════════════════════════════════════╕
# │                     WALL-RANDOM-AWWW                     │
# ╘══════════════════════════════════════════════════════════╛
set -euo pipefail

# ──「 Config 」──────────────────────────────────────────────
readonly INTERVAL=20 # segundos entre cambios
readonly FPS=60      # fotogramas de la transición
readonly TYPE=fade   # tipo de transición awww
readonly DURATION=3  # duración de la transición en segundos

readonly BACKGROUND_DIR="${KASUMI_WALLPAPERS_DIR:-}"
readonly FALLBACK_IMAGE="${XDG_CACHE_HOME:-$HOME/.cache}/kasumi/no-image.png"

# Sin awww no hay trabajo: salida silenciosa para no romper el autostart
command -v awww > /dev/null 2>&1 || exit 0

# ──「 Funciones 」───────────────────────────────────────────
ensure_fallback_image() {
    command -v magick > /dev/null 2>&1 || return 1
    command -v timeout > /dev/null 2>&1 || return 1
    mkdir -p "$(dirname "$FALLBACK_IMAGE")" 2> /dev/null || return 1
    # ImageMagick no usa OpenCL por defecto
    # 1920x1080 es la resolucion del monitor primario (eDP-1); un cuadrado deformaria el crop 16:9
    timeout 10 magick \
        -size 1920x1080 \
        xc:'#2E383D' \
        -gravity center \
        -fill white \
        -pointsize 80 \
        -annotate +0+0 '[NO IMAGE]' \
        "png:${FALLBACK_IMAGE}" \
        2> /dev/null
}

set_random_wallpaper() {
    local random_image
    # Directorio ausente o sin ficheros: se cae al fallback
    if [[ -d "$BACKGROUND_DIR" ]]; then
        # Fallo esperado si no hay imágenes: se descarta el error
        random_image=$(find "$BACKGROUND_DIR" -type f 2> /dev/null | shuf -n 1 2> /dev/null || true)
    fi
    # Directorio ausente o sin valor: fallback visible en vez de fallar en silencio
    if [[ -z "$random_image" ]]; then
        # Fallback no generable (sin magick/timeout o error):
        # se omite la rotación, no romper autostart
        ensure_fallback_image || return 0
        random_image="$FALLBACK_IMAGE"
    fi
    # Transición fallida (daemon no disponible) es benigna en autostart
    awww img "$random_image" \
        --transition-type "$TYPE" \
        --transition-duration "$DURATION" \
        --transition-fps "$FPS" \
        2> /dev/null || true
}

# ──「 Bucle Principal 」─────────────────────────────────────
main() {
    # Salida limpia ante TERM/INT: bajo set -e,
    # terminar el bucle sin trap reportaría error en autostart
    trap 'exit 0' TERM INT
    while true; do
        set_random_wallpaper
        sleep "$INTERVAL"
    done
}

main "$@"
