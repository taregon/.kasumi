# Propósito: bootstrap leído si ZDOTDIR vacío (fallback HOME).
# Define ZDOTDIR para que el resto se lea desde $ZDOTDIR.
# Precedencia: afecta solo resolución inicial de ZDOTDIR;
# ajustes de PATH/SSH_AUTH_SOCK van en $ZDOTDIR/.zshenv.
# Minimal: sin output, sin asumir tty (zsh Files 5.1).
export ZDOTDIR=$HOME/.config/zsh
