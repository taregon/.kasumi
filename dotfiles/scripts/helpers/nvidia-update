#!/usr/bin/env bash
# Actualiza de forma atomica los paquetes NVIDIA 580xx de la AUR.
# En IgnorePkg, paru -Syu no los toca; fail-stop: si un subpaquete no
# construye, aborta sin instalar nada y evita el estado parcial dkms/utils.
# La instalacion usa pacman -U desde fichero, que no esta sujeta a IgnorePkg
# (solo rige operaciones de sincronizacion); los avisos de omitido de -Syu
# son el comportamiento esperado, no un error del script.

set -euo pipefail

# ──「 Setup 」───────────────────────────────────────────────
readonly CLONE="$HOME/.cache/paru/clone"
declare -ra AUR_BASES=(nvidia-580xx-utils nvidia-580xx-settings)
# Splits que produce cada pkgbase; la purga y la transaccion solo operan
# sobre estos nombres y nunca sobre otras fuentes del clon.
declare -rA BASE_SPLITS=(
    [nvidia - 580xx - utils]="nvidia-580xx-utils opencl-nvidia-580xx nvidia-580xx-dkms"
    [nvidia - 580xx - settings]="nvidia-580xx-settings libxnvctrl-580xx"
)
# Linea dedicada en [options]; al ser lista acumulativa, coexiste con otras.
readonly IGNORE_LINE="IgnorePkg   = nvidia-580xx-utils nvidia-580xx-dkms \
nvidia-580xx-settings opencl-nvidia-580xx libxnvctrl-580xx"

# ──「 Helpers 」─────────────────────────────────────────────
# El clon acumula .pkg.tar.zst de pkgrel anteriores porque makepkg solo
# sobrescribe la misma version; la purga acotada evita que el glob mezcle
# versiones en la transaccion.
# Recibe: directorio del clon, version esperada y splits de la base.
purge_stale_pkgs() {
    local dir="$1"
    local expected="$2"
    shift 2
    local -a splits=("$@")
    local -a stale=()
    local f name split keep

    shopt -s nullglob
    stale=("$dir"/*.pkg.tar.zst)
    shopt -u nullglob

    # Las guardas ${...+...} toleran array vacio bajo set -u; simplificarlas
    # reintroduce el aborto cuando el clon no tiene paquetes previos.
    for f in ${stale[@]+"${stale[@]}"}; do
        name=$(basename "$f")
        keep=0
        for split in ${splits[@]+"${splits[@]}"}; do
            if [[ "$name" == "$split-"* ]]; then
                keep=1
                break
            fi
        done
        # Fuera de la allowlist: artefacto ajeno al driver, se conserva.
        ((keep)) || continue
        # La depuracion nunca entra en la transaccion, siempre se purga.
        if [[ "$name" == *-debug-*.pkg.tar.zst ]]; then
            rm -f "$f"
            printf ">>INFO purgado: %s\n" "$name"
            continue
        fi
        # Solo coincide la version esperada; el resto son rancios.
        if [[ "$name" != *-"$expected"-* ]]; then
            rm -f "$f"
            printf ">>INFO purgado: %s\n" "$name"
        fi
    done
}

# ──「 Validación 」──────────────────────────────────────────
# Fallo temprano y consistente: herramientas requeridas y clones de paru.
for cmd in git sed awk grep pacman makepkg sudo; do
    command -v "$cmd" > /dev/null || {
        printf ">>FAIL herramienta requerida no encontrada: %s\n" "$cmd"
        exit 1
    }
done

for base in "${AUR_BASES[@]}"; do
    [[ -d "$CLONE/$base" ]] || {
        printf ">>FAIL clon AUR no encontrado: %s (ejecuta 'paru -S %s' una vez)\n" "$base" "$base"
        exit 1
    }
done

# IgnorePkg presente: paru -Syu no toca NVIDIA. Si la linea dedicada falta,
# se inserta tras [options]; repetir IgnorePkg es valido y acumulativo.
if grep -qF "$IGNORE_LINE" /etc/pacman.conf; then
    printf ">>INFO IgnorePkg presente\n"
else
    printf ">>WARN IgnorePkg ausente en /etc/pacman.conf\n"
    printf "   > Se requiere sudo para insertarlo\n"
    sudo sed -i "/^\[options\]/a $IGNORE_LINE" /etc/pacman.conf
    grep -qF "$IGNORE_LINE" /etc/pacman.conf || {
        printf ">>FAIL No se pudo insertar IgnorePkg en /etc/pacman.conf\n"
        exit 1
    }
    printf ">>PASS IgnorePkg insertado: /etc/pacman.conf\n"
fi

# ──「 Construcción 」────────────────────────────────────────
built=()
for base in "${AUR_BASES[@]}"; do
    # --ff-only es fail-stop ante historial reescrito o clon divergente;
    # recuperar con reset --hard al remoto o re-clonando via paru -S.
    git -C "$CLONE/$base" pull --ff-only --quiet
    pkgver=$(sed -n 's/^pkgver=//p' "$CLONE/$base/PKGBUILD" | tr -d "'\"")
    pkgrel=$(sed -n 's/^pkgrel=//p' "$CLONE/$base/PKGBUILD" | tr -d "'\"")
    expected="$pkgver-$pkgrel"
    read -ra splits <<< "${BASE_SPLITS[$base]}"
    need_build=0
    for split in "${splits[@]}"; do
        # Un split ausente cuenta como desactualizado: se reconstruye la
        # transaccion completa en vez de abortar sin diagnostico por pipefail.
        installed=$(pacman -Q "$split" 2> /dev/null | awk '{print $2}' || true)
        if [[ "${installed:-}" != "$expected" ]]; then
            need_build=1
            printf ">>INFO %s desactualizado (%s -> %s)\n" \
                "$split" "${installed:-ausente}" "$expected"
        fi
    done
    if ((need_build == 0)); then
        printf ">>INFO %s al dia (%s)\n" "$base" "$expected"
        continue
    fi
    # makepkg -C es cleanbuild, no cambio de directorio como git -C; el
    # subshell aisla el cd y construye sobre el PKGBUILD recien traido.
    # -d salta la resolucion de dependencias: evita operaciones -S durante el
    # build; los makedeps ya los dejo el paru -S inicial que creo el clon.
    (cd "$CLONE/$base" && makepkg --noconfirm -C -c -d -f)
    # Solo entran los splits de esta base en la version esperada; la
    # depuracion y los rancios quedan fuera de la transaccion.
    shopt -s nullglob
    candidates=("$CLONE/$base/"*-"$expected"-*.pkg.tar.zst)
    shopt -u nullglob
    added=0
    # Misma guarda que en purge_stale_pkgs: candidates puede venir vacio.
    for f in ${candidates[@]+"${candidates[@]}"}; do
        name=$(basename "$f")
        [[ "$name" == *-debug-*.pkg.tar.zst ]] && continue
        for split in "${splits[@]}"; do
            if [[ "$name" == "$split-$expected-"* ]]; then
                built+=("$f")
                added=1
                break
            fi
        done
    done
    # makepkg puede salir bien sin artefacto util ante un pkgname renombrado.
    if ((added == 0)); then
        printf ">>FAIL sin paquetes generados para %s (%s)\n" "$base" "$expected"
        exit 1
    fi
done

# ──「 Instalación 」─────────────────────────────────────────
# Transacción única: utils, opencl y dkms entran juntos con la misma versión,
# de modo que la dependencia estricta dkms -> utils=${pkgver} queda satisfecha.
if ((${#built[@]})); then
    sudo pacman -U --noconfirm \
        "${built[@]}"
    # Con la nueva version instalada, los rancios pierden su valor de
    # rollback y se purgan acotados a los splits de cada base.
    for base in "${AUR_BASES[@]}"; do
        pkgver=$(sed -n 's/^pkgver=//p' "$CLONE/$base/PKGBUILD" | tr -d "'\"")
        pkgrel=$(sed -n 's/^pkgrel=//p' "$CLONE/$base/PKGBUILD" | tr -d "'\"")
        read -ra splits <<< "${BASE_SPLITS[$base]}"
        purge_stale_pkgs "$CLONE/$base" "$pkgver-$pkgrel" "${splits[@]}"
    done
    printf ">>PASS nvidia-580xx actualizado a %s\n" \
        "$(pacman -Q nvidia-580xx-utils | awk '{print $2}')"
fi

exit 0
